---
// 각주 한 줄. 그림과 표 아래 .notes 묶음 안에 놓인다(묶음 앞에 "주" 머리가 붙는다).
// 문장은 그 자체로 뜻이 통하게 쓴다. head는 예전 호환용이라 화면에 내지 않는다.
// 범례나 축을 되풀이하는 각주, 읽는 법 설명은 두지 않는다(DESIGN.md "각주").
interface Props {
  head?: string;
  body?: string;
  caution?: boolean;
}
const { body } = Astro.props;
---

<p class="note">{body ? <Fragment set:html={body} /> : <slot />}</p>
