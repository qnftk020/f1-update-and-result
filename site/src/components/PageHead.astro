---
// 페이지 머리(DESIGN.md "페이지 머리"): 길잡이(홈 › 상위 페이지 › 이 페이지) -> h1(+ 원어 latin, lang="en") -> 한 줄 메타
// box(개체 페이지: 드라이버, 컨스트럭터, 팀 계보): [왼쪽: slot(요약 표, 비교 링크) | 오른쪽: 정보 표(facts)].
// 그 밖: facts를 제목 아래 가로 요약 줄(항목 이름 위, 값 아래)로 놓고 slot(선택 메뉴 등)은 그 아래에 둔다.
// kicker는 상위 쪽 링크 HTML 목록이다(홈은 자동으로 앞에 붙는다). 홈 쪽은 crumbs={false}로 길잡이를 숨긴다.
// 서술 리드 문단은 두지 않는다(2026-11-26). 정의나 주의가 필요하면 표 아래 각주로 쓴다.
// facts: [['국적', '네덜란드'], ['생년월일', '1997-09-30']]. 값은 HTML 문자열이다.
import { routes } from '../lib/paths.ts';

interface Props {
  kicker?: string[];
  title: string;
  latin?: string;
  /** 제목 아래 한 줄(약어, 기간 같은 짧은 정보). HTML 문자열 */
  meta?: string;
  facts?: [string, string][];
  /** 정보 상자 제목. 없으면 제목 없이 */
  factsTitle?: string;
  crumbs?: boolean;
  /** 개체 페이지: 요약 표 오른쪽에 정보 표를 둔다 */
  box?: boolean;
  /** 제목 줄 띠 색. 'red'는 체코지수 페이지만 쓴다(사용자 지정 예외, DESIGN.md) */
  tone?: 'red';
}
const { kicker = [], title, latin, meta, facts, factsTitle, crumbs = true, box = false, tone } = Astro.props;
const plainTitle = title.replace(/<[^>]+>/g, '');
const hasSlot = Astro.slots.has('default');
const hasFacts = Boolean(facts && facts.length > 0);
---

<header class:list={['page-head', { 'head-red': tone === 'red' }]}>
  {
    crumbs && (
      <nav aria-label="위치">
        <ol class="crumbs">
          <li><a href={routes.home()}>홈</a></li>
          {kicker.map((k) => <li set:html={k} />)}
          <li aria-current="page">{plainTitle}</li>
        </ol>
      </nav>
    )
  }
  <h1><Fragment set:html={title} />{latin && <Fragment> <span class="latin" lang="en">{latin}</span></Fragment>}</h1>
  {meta && <p class="head-meta" set:html={meta} />}
  {
    !(box && hasSlot) && hasFacts && (
      <dl class="facts facts-inline">
        {facts!.map(([dt, dd]) => (
          <div>
            <dt set:html={dt} />
            <dd set:html={dd} />
          </div>
        ))}
      </dl>
    )
  }
  {hasSlot && !box && <div class="head-tools"><slot /></div>}
  {
    hasSlot && box && (
      <div class="head-grid">
        <div class="head-main">
          <slot />
        </div>
        {hasFacts && (
          <aside class="info" aria-label={factsTitle ?? `${plainTitle} 정보`}>
            {factsTitle && <p class="info-title">{factsTitle}</p>}
            <dl class="facts">
              {facts!.map(([dt, dd]) => (
                <div>
                  <dt set:html={dt} />
                  <dd set:html={dd} />
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    )
  }
</header>
