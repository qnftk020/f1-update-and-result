---
// 페이지 머리: 갈래 줄(kicker) -> h1(+ 원어 latin, lang="en") -> 리드 -> 사실 줄(facts) -> slot(계보 칩, 시즌 이동, 안내 상자).
// kicker는 상위 쪽 링크(위치 표시)만 담는다. 주 메뉴 첫 쪽에는 두지 않고, 사실 줄과 겹치는 값을 넣지 않는다.
// lead는 데이터에 관한 문장만 쓴다(쪽이 자기를 설명하는 문장, 조작법은 쓰지 않는다). 사실 줄과 겹치면 뺀다.
// kicker 항목과 title, lead, facts 값은 HTML 문자열이다. lead는 keepNames()를 거친다.
// facts: [['예선 노면', '마른 노면 (OpenF1 판정)'], ['결승', '58랩']]
import { keepNames } from '../lib/typeset.ts';

interface Props {
  kicker?: string[];
  title: string;
  latin?: string;
  lead?: string;
  leadId?: string;
  facts?: [string, string][];
}
const { kicker, title, latin, lead, leadId, facts } = Astro.props;
---

<header class="page-head">
  {kicker && kicker.length > 0 && <p class="kicker">{kicker.map((k) => <span set:html={k} />)}</p>}
  <h1><Fragment set:html={title} />{latin && <Fragment> <span class="latin" lang="en">{latin}</span></Fragment>}</h1>
  {lead && <p class="lead" id={leadId} set:html={keepNames(lead)} />}
  {
    facts && facts.length > 0 && (
      <dl class="facts">
        {facts.map(([dt, dd]) => (
          <div>
            <dt set:html={dt} />
            <dd set:html={dd} />
          </div>
        ))}
      </dl>
    )
  }
  <slot />
</header>
