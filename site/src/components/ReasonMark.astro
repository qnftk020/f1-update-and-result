---
// 변경 사유 범주 기호: 성능 ■, 서킷 대응 □, 신뢰성 ▲, 기타 ×. withLabel이면 한국어 범주 이름을 붙인다.
// raw(원문 사유, 예: "Performance - Local Load")를 주면 이름 뒤에 lang="en"으로 그대로 적는다.
import { labels } from '../lib/data.ts';
import { glyphHtml } from '../lib/markup.ts';
import type { ReasonCategory } from '../lib/types.ts';

interface Props {
  cat: ReasonCategory;
  withLabel?: boolean;
  raw?: string;
}
const { cat, withLabel = false, raw } = Astro.props;
---

<span class="cat"><Fragment set:html={glyphHtml(cat)} />{withLabel && labels.reason_categories[cat]}</span>{
  raw && <span lang="en">{raw}</span>
}
