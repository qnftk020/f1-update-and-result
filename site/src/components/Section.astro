---
// 절(DESIGN.md "절"): 위 1px 잉크 괘선, h2와 오른쪽 메타(범위 글, 보기 바꾸기, 링크), 그다음 표와 그림.
// 절 첫머리에 요약 문장을 두지 않는다(2026-11-26). 해석을 제한하는 정의·주의는 표나 그림 아래 각주로 쓴다.
// meta는 HTML 문자열이나 slot="meta". 번호를 붙이지 않는다.
interface Props {
  id: string;
  title: string;
  meta?: string;
  class?: string;
}
const { id, title, meta, class: cls } = Astro.props;
const hasMeta = Boolean(meta) || Astro.slots.has('meta');
---

<section class:list={['sec', cls]} id={id} aria-labelledby={`${id}-h`}>
  <div class="sec-head">
    <h2 id={`${id}-h`}>{title}</h2>
    {
      hasMeta && (
        <div class="sec-meta">
          {meta && <Fragment set:html={meta} />}
          <slot name="meta" />
        </div>
      )
    }
  </div>
  <slot />
</section>
