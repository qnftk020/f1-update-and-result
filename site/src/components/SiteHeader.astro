---
// 사이트 머리말: 남색 띠(위 4px 블루·핑크 줄), 사이트 이름 + "비공식 팬 프로젝트" 꼬리표, 일곱 메뉴, 테마 세 칸 전환.
// 960px 아래에서는 "메뉴" 단추가 메뉴와 테마를 함께 접는다(스크립트가 없으면 메뉴를 펼쳐 두고 단추와 테마를 숨긴다).
// 아래 상태 줄: 최신 대회 · 결과 기준일 · 업그레이드 문서 · 검수 대기. 640px 아래는 최신 대회와 검수 대기만.
import { meta, status } from '../lib/data.ts';
import { n0 } from '../lib/format.ts';
import { badgeHtml } from '../lib/markup.ts';
import { NAV, type NavKey, routes } from '../lib/paths.ts';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
const last = status.lastRace;
const review = status.reviewDocuments;
const j = meta.sources.jolpica;
---

<header class="site">
  <div class="site-top">
    <div class="wrap site-bar">
      <a class="brand" href={routes.home()}><span class="brand-mark" aria-hidden="true"></span><span class="brand-name">F1 업그레이드와 성능 추이</span><span class="brand-tag">비공식 팬 프로젝트</span></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">메뉴</button>
      <div class="site-menu" id="site-menu">
        <nav class="nav" aria-label="주 메뉴">
          <ul>
            {NAV.map((n) => <li><a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="theme" role="group" aria-label="화면 테마">
          <button type="button" data-theme-set="auto" aria-pressed="true">자동</button><button type="button" data-theme-set="light" aria-pressed="false">밝게</button><button type="button" data-theme-set="dark" aria-pressed="false">어둡게</button>
        </div>
      </div>
    </div>
  </div>
  <div class="status">
    <p class="wrap">
      <span>최신 대회 <b>{last.season} R{last.round} {last.short_ko}</b> <span class="nw">{last.date}</span></span>
      <span class="hide-md">결과 기준일 <b class="nw">{j.dump ?? j.version.slice(0, 10)}</b> 덤프{j.api && `, API ${j.api} 반영`}</span>
      <span class="hide-md">업그레이드 문서 <b>{n0(meta.counts.upgrade_documents)}건</b>, 항목 <b>{n0(meta.counts.upgrade_items)}건</b></span>
      {
        review.length > 0 && (
          <span>
            <Fragment set:html={badgeHtml('review', '검수 대기')} /> <b>{review.length}건</b>{' '}
            {`(${review.map((d) => `${d.season} R${d.round} ${d.event_short_ko}`).join(', ')})`}
          </span>
        )
      }
    </p>
  </div>
</header>
