---
// 표 아래 자료 표시. 화면에 줄을 내지 않고 데이터원 키만 남긴다(lib/sources.ts citeKeys).
// 빌드 뒤 scripts/page-sources.mjs가 페이지에 쓰인 데이터원을 꼬리말 "자료" 줄로 모은다(DESIGN.md "자료 표기").
import { citeKeys } from '../lib/sources.ts';

interface Props {
  source: string;
  asof: string;
  as?: 'p' | 'figcaption';
}
const { source, asof } = Astro.props;
---

<template data-cite={citeKeys(source, asof).join(' ')}></template>
