---
// 드라이버·컨스트럭터 목록 쪽의 비교 절(#compare). 목록 표 첫 칸의 체크로 최대 3개를 고르면 통산 기록,
// 시즌별 최종 순위와 누적 우승, 같은 대회 결승 맞대결이 여기 나란히 나온다. 고른 조합은 주소(?cmp=senna,prost)에 남는다.
// 목록 표에는 data-cmp-table을, 행에는 data-id와 체크 칸(input.cmp-box)을 둔다. 목록 절의 알림 줄은 #cmp-line이다.
// 브라우저 동작은 compare-client.ts, 계산은 lib/compare.ts, 차트는 lib/charts/compare.js, 자료는 lib/compare-data.ts에 있다.
import Figure from '../Figure.astro';
import Section from '../Section.astro';
import Seg from '../Seg.astro';
import SourceLine from '../SourceLine.astro';
import { MAX_PICK, type Kind } from '../../lib/compare.ts';
import { JOLPICA, asofJolpica } from '../../lib/sources.ts';

interface Props {
  kind: Kind;
  /** 주소에 고른 목록이 없을 때 처음 보이는 비교(그 시즌 1-3위) */
  def: string[];
  last: number;
}
const { kind, def, last } = Astro.props;
const ASOF = asofJolpica();
const noun = kind === 'd' ? '드라이버' : '컨스트럭터';
---

<Section id="compare" title={`${noun} 비교`}>
  <noscript>
    <p class="notice"><span>스크립트를 켜면 비교를 사용할 수 있다.</span></p>
  </noscript>
  <div class="cmp" id="cmp" data-kind={kind} data-def={def.join(',')} data-js-only>
    <div class="cmp-picked">
      <p class="lab">
        <span id="cmp-picked-label">선택한 {noun}</span> <span class="mono" id="cmp-count">0/{MAX_PICK}</span>
        <a href="#list" id="cmp-to-list">목록에서 선택</a>
      </p>
      <ul class="cmp-chips" id="cmp-chips" aria-labelledby="cmp-picked-label"></ul>
    </div>

    <h3 class="sub-title"><span>통산 기록</span></h3>
    <div id="cmp-totals"></div>
    <SourceLine source={`${JOLPICA} 결승 결과와 순위`} asof={ASOF} />
    <p class="tbl-note" id="cmp-totals-note"></p>

    <h3 class="sub-title"><span>시즌별 흐름</span></h3>
    <Seg
      label="가로축"
      attr="mode"
      id="cmp-mode"
      items={[
        { value: 'year', label: '연도', pressed: true },
        { value: 'career', label: '데뷔 뒤 햇수' },
      ]}
    />
    <Figure
      wide
      manual
      id="f-cmp-pos"
      title="시즌 최종 순위"
      source={`${JOLPICA} ${kind === 'd' ? '드라이버' : '컨스트럭터'} 순위`}
      asof={ASOF}
      notes={[{ body: '큰 마커는 챔피언 시즌이다.' }]}
    />
    <Figure
      wide
      manual
      id="f-cmp-wins"
      title="누적 결승 우승"
      source={`${JOLPICA} 결승 결과`}
      asof={ASOF}
    />

    <h3 class="sub-title"><span>결승 맞대결</span></h3>
    <div id="cmp-h2h"></div>
    <SourceLine source={`${JOLPICA} 결승 결과${kind === 'd' ? '와 예선 기록' : ''}, 맞대결은 이 사이트 계산`} asof={ASOF} />
    <p class="tbl-note">
      완주로 분류된 쪽이 앞이고, 둘 다 분류되면 순위로 판정한다. 둘 다 분류되지 않았거나 순위가 같은 대회는 집계하지 않는다.{
        kind === 'd' ? ' 예선 비교는 1994년부터다.' : ' 컨스트럭터는 대회마다 가장 앞선 차끼리 비교한다.'
      } 인디애나폴리스 500은 제외한다.
    </p>
  </div>
</Section>

<script>
  import { start } from './compare-client.ts';

  start();
</script>

<style>
  .cmp-picked {
    margin-top: var(--sp-3);
    padding: var(--sp-2) 0 var(--sp-3);
    border-top: 1px solid var(--hair);
  }
  .cmp-picked .lab {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--sp-3);
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--ink-2);
  }
  .cmp-picked .lab a {
    font-weight: 400;
  }
  .cmp-chips {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    min-height: 28px;
  }
  .cmp-chips :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 0 0 0 var(--sp-2);
    border: 1px solid var(--control);
    border-radius: var(--radius-2);
    font-size: var(--fs-small);
  }
  .cmp-chips :global(li.empty-chip) {
    border-style: dashed;
    padding-right: var(--sp-3);
    color: var(--ink-3);
  }
  .cmp-chips :global(button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    min-height: 26px;
    border: 0;
    border-left: 1px solid var(--hair);
    background: transparent;
    font: inherit;
    font-size: var(--fs-body);
    line-height: 1;
    color: var(--ink-2);
    cursor: pointer;
  }
  .cmp-chips :global(button:hover) {
    color: var(--ink);
    background: var(--paper-2);
  }
  .cmp h3.sub-title {
    margin-top: var(--sp-5);
  }
  .cmp-picked + h3.sub-title {
    margin-top: var(--sp-2);
  }
  .cmp > :global(.seg) {
    margin-top: var(--sp-3);
    justify-self: start;
    width: fit-content;
  }
  #cmp-totals,
  #cmp-h2h {
    margin-top: var(--sp-3);
  }
  #cmp-totals :global(.empty-line),
  #cmp-h2h :global(.empty-line) {
    padding: var(--sp-2) 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  #cmp-totals :global(th .key),
  #cmp-h2h :global(.key),
  .cmp-chips :global(.key) {
    margin-right: 4px;
    vertical-align: -1px;
  }
  #cmp-totals :global(tbody th) {
    font-size: var(--fs-small);
    color: var(--ink-2);
    border-bottom: 1px solid var(--hair);
    vertical-align: top;
    white-space: normal;
    min-width: 5.5em;
    word-break: keep-all;
  }
  #cmp-totals :global(td.lead-v) {
    font-weight: 700;
  }
  #cmp-h2h :global(.h2h-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--sp-5);
  }
  #cmp-h2h :global(.h2h-pair) {
    min-width: 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
  }
  #cmp-h2h :global(.h2h-title) {
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.4;
  }
  #cmp-h2h :global(.h2h-part) {
    margin-top: var(--sp-3);
  }
  #cmp-h2h :global(.h2h-part + .h2h-part) {
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hair);
  }
  #cmp-h2h :global(.h2h-head) {
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--ink-2);
  }
  #cmp-h2h :global(.h2h-score) {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-body);
    font-variant-numeric: tabular-nums;
  }
  #cmp-h2h :global(.h2h-bar) {
    display: flex;
    gap: 2px;
    height: 8px;
    margin-top: 6px;
    forced-color-adjust: none;
  }
  #cmp-h2h :global(.h2h-bar span) {
    display: block;
    height: 100%;
    border-radius: 2px;
  }
  #cmp-h2h :global(.h2h-sub),
  #cmp-h2h :global(.h2h-none) {
    margin-top: 4px;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .tbl-note {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: var(--measure);
  }

  /* 목록 표의 고르기 칸과 목록 절의 알림 줄(목록 쪽 템플릿에 있어 :global로 단다) */
  :global(.dt th.pick),
  :global(.dt td.pick) {
    width: 36px;
    padding-left: 0;
    padding-right: var(--sp-2);
    text-align: center;
  }
  :global(.dt td.pick label) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 24px;
    cursor: pointer;
  }
  :global(.dt .cmp-box) {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  :global(.dt .cmp-box:disabled) {
    cursor: not-allowed;
  }
  :global(.dt tr.cmp-on > td) {
    background: var(--s1-wash);
  }
  :global(.cmp-line) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--sp-3);
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
</style>
