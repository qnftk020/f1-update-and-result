---
// 드라이버 쪽 /drivers/<드라이버 ID>/. drivers.json의 모든 드라이버(결승 행이 한 번이라도 있는 817명)마다 하나다.
// 절: 챔피언십 순위, 1위 점수 대비 비율, 우승과 포디움, 팀 동료 비교, 팀 이력, 시즌별 기록, 결승 결과.
// 자료는 driver/<id>.json 하나만 읽는다. 차트 자료는 그 쪽에 필요한 시즌 행만 싣는다(대회별 결과는 정적 표로만 둔다).
// 시즌이 하나뿐이거나 비교할 값이 0인 절은 그리지 않는다.
import DataTable, { type Column } from '../../components/DataTable.astro';
import Figure from '../../components/Figure.astro';
import JsonData from '../../components/JsonData.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import SourceLine from '../../components/SourceLine.astro';
import Tiles from '../../components/Tiles.astro';
import { buildDriver, gridCell, outcome, pts, span, teamNames, yearsText } from '../../components/driver/model.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { driverLink } from '../../lib/driver-links.ts';
import { drivers, getDriver, type DriverRace, type DriverSeasonRow } from '../../lib/drivers-data.ts';
import { n0, num } from '../../lib/format.ts';
import { routes } from '../../lib/paths.ts';
import { JOLPICA, asofJolpica } from '../../lib/sources.ts';
import { en, esc, nw } from '../../lib/typeset.ts';

export function getStaticPaths() {
  return drivers.map((d) => ({ params: { id: d.id } }));
}

const { id } = Astro.params as { id: string };
const d = await getDriver(id);
const M = buildDriver(d);
const { rows, chartRows, stints, teamRows, mateSeason, mates, tot, reads, titleSet } = M;
const from = d.first_season;
const to = d.last_season;
const multi = rows.length >= 2;
const SRC_RES = `${JOLPICA} 결승 결과`;
const SRC_ST = `${JOLPICA} 드라이버 순위(시즌 마지막 라운드)`;
const ASOF = asofJolpica();

// ------------------------------------------------------------------ 팀 이름과 계보 링크
const teamCell = (r: DriverSeasonRow) =>
  r.teams.map((t) => (t.lineage_id ? `<a href="${routes.team(t.lineage_id)}" lang="en">${esc(t.name)}</a>` : en(esc(t.name)))).join(', ');
const teamOf = (s: number, c: string) => rows.find((r) => r.s === s)?.teams.find((t) => t.id === c)?.name ?? c;
const posText = (r: DriverSeasonRow) => (r.pos ? `${r.pos}위` : r.excluded ? '실격' : '<span class="muted">미부여</span>');

// ------------------------------------------------------------------ 순위 계단
const hasSteps = multi && M.ranked.length >= 1;
const stepLegend = [
  { type: 'dot' as const, color: 's1', label: '시즌 최종 순위' },
  ...(d.titles ? [{ type: 'dot' as const, color: 's2', label: '챔피언 시즌' }] : []),
  ...(rows.some((r) => r.pos == null) ? [{ type: 'ring' as const, color: 'ctx', label: '순위 미부여 또는 실격 (맨 아래 줄)' }] : []),
];
const stepCols: Column<DriverSeasonRow>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '팀', render: (r) => en(esc(teamNames(r))) },
  { label: '순위', num: true, render: posText },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '') },
  { label: '1위 점수', num: true, render: (r) => pts(r.champ_pts) },
];

// ------------------------------------------------------------------ 1위 점수 대비
const hasShare = multi && chartRows.some((r) => (r.share ?? 0) > 0);
const shareCols: Column<(typeof chartRows)[number]>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '') },
  { label: '1위 점수', num: true, render: (r) => pts(r.cp) },
  { label: '비율', num: true, render: (r) => (r.share != null && !r.ex ? `${num(r.share, 1)}%` : r.ex ? '실격' : '') },
];

// ------------------------------------------------------------------ 우승과 포디움
const hasPod = multi && d.podiums > 0;
const podCols: Column<(typeof chartRows)[number]>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '출전', num: true, render: (r) => String(r.e) },
  { label: '우승', num: true, render: (r) => String(r.w) },
  { label: '2·3위', num: true, render: (r) => String(r.p - r.w) },
  { label: '포디움', num: true, render: (r) => String(r.p) },
];

// ------------------------------------------------------------------ 팀 동료
const hasMates = tot.rc + tot.qc > 0;
const mateRowsFlat = rows.flatMap((r) => r.mates.map((m) => ({ s: r.s, ...m })));
const twinMate = (q: boolean): Column[] => [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '동료', render: (r) => en(esc(r.name)) },
  { label: '팀', render: (r) => en(esc(teamOf(r.s, r.c))) },
  { label: '함께한 대회', num: true, render: (r) => String(r.n) },
  { label: q ? '예선 비교' : '결승 비교', num: true, render: (r) => String(q ? r.qc : r.rc) },
  { label: '앞섬', num: true, render: (r) => String(q ? r.qa : r.ra) },
  { label: '뒤짐', num: true, render: (r) => String(q ? r.qc - r.qa : r.rc - r.ra) },
];
const mateData = mateSeason.map((m) => ({ ...m, mates: m.mates.map(({ id: _i, ...rest }) => rest) }));
const qFrom = Math.max(from, 1994);
const hasQ = tot.qc > 0;
const ratio = (a: number, n: number) => (n ? `${a}:${n - a}` : '<span class="muted">비교 0</span>');
const mateCols: Column[] = [
  { label: '동료', cls: 'stick', render: (m) => driverLink(m.id, en(esc(m.name))) },
  { label: '시즌', render: (m) => nw(yearsText(m.seasons)) },
  { label: '함께한 대회', num: true, cls: 'hide-xs', render: (m) => String(m.n) },
  { label: '결승 앞섬:뒤짐', num: true, render: (m) => ratio(m.ra, m.rc) },
  { label: '예선 앞섬:뒤짐', num: true, render: (m) => ratio(m.qa, m.qc) },
];
const lowQ = rows.filter((r) => r.s >= 1994 && r.s <= 2002 && r.q_cov < r.entries);
const mateNotes = [
  {
    head: '결승 비교',
    body: '같은 대회, 같은 컨스트럭터로 나선 두 드라이버 가운데 완주로 분류된 쪽이 앞이다. 둘 다 분류되면 순위가 작은 쪽이 앞이고, 둘 다 분류되지 않으면 세지 않는다. 리타이어, 실격, 출발하지 않음은 분류되지 않은 쪽이다.',
  },
  {
    head: '예선 비교',
    body: `더 늦은 세션(Q3, Q2, Q1 순)까지 남은 쪽이 앞이고, 같은 세션이면 그 세션 순위로 가른다. 두 드라이버 모두 Jolpica 예선 기록이 있는 대회만 센다(1994년부터).${lowQ.length ? ` ${lowQ.map((r) => r.s).join(', ')}년은 예선 기록이 일부 대회에만 있다.` : ''}`,
  },
  ...(from < 1980
    ? [{ head: '주의', body: '1980년 이전은 참가 팀 구분이 자료에 없어, 같은 섀시를 쓴 다른 참가 팀 드라이버도 동료로 잡힌다. 인디애나폴리스 500은 비교에서 뺀다.', caution: true }]
    : []),
];

// ------------------------------------------------------------------ 팀 이력
const hasTeamChart = teamRows.length >= 2;
const stintCols: Column[] = [
  { label: '기간', render: (s) => nw(span(s.from, s.to)) },
  {
    label: '팀',
    render: (s) => {
      const name = s.names.map((n: string) => esc(n)).join(', ');
      return s.lineage ? `<a href="${routes.team(s.lineage)}" lang="en">${name}</a>` : en(name);
    },
  },
  { label: '시즌', num: true, render: (s) => String(s.seasons.length) },
  { label: '출전', num: true, render: (s) => String(s.e) },
  { label: '우승', num: true, render: (s) => String(s.w) },
  { label: '포디움', num: true, cls: 'hide-xs', render: (s) => String(s.p) },
];
const teamTwin: Column[] = [
  { label: '팀', render: (t) => en(esc(t.name)) },
  { label: '기간', render: (t) => t.span },
  { label: '시즌', num: true, render: (t) => String(t.seasons.length) },
  { label: '출전', num: true, render: (t) => String(t.e) },
  { label: '우승', num: true, render: (t) => String(t.w) },
  { label: '포디움', num: true, render: (t) => String(t.p) },
];
const linked = stints.some((s) => s.lineage);

// ------------------------------------------------------------------ 시즌별 기록
const seasonCols: Column<DriverSeasonRow>[] = [
  { label: '시즌', render: (r) => `<a href="${routes.season(r.s)}">${r.s}</a>` },
  { label: '팀', render: teamCell },
  { label: '출전', num: true, render: (r) => `${r.entries}<span class="of">/${r.rounds}</span>` },
  { label: '우승', num: true, render: (r) => String(r.wins) },
  { label: '포디움', num: true, render: (r) => String(r.podiums) },
  { label: '폴', num: true, cls: 'hide-sm', render: (r) => String(r.poles) },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '<span class="muted">미부여</span>') },
  {
    label: '1위 대비',
    num: true,
    cls: 'hide-sm',
    render: (r) => (r.pts != null && r.champ_pts && !r.excluded ? `${num((r.pts / r.champ_pts) * 100, 1)}%` : ''),
  },
  { label: '순위', num: true, cls: 'pos', render: posText },
];
const dropped = rows.filter((r) => r.pts != null && r.rpts + r.spts - (r.pts as number) > 0.005);

// ------------------------------------------------------------------ 결승 결과
const raceSeasons = [...new Set(d.races.map((r) => r.s))].sort((a, z) => z - a);
const latest = raceSeasons[0];
const raceCols: Column<DriverRace>[] = [
  { label: 'R', num: true, render: (r) => String(r.r) },
  {
    label: '대회',
    render: (r) => `${esc(r.n)}${r.x ? '<span class="sub-line">한 대회에 결과 행이 여럿(차량 공유 또는 교대)</span>' : ''}`,
  },
  { label: '팀', cls: 'hide-xs', render: (r) => en(esc(teamOf(r.s, r.c))) },
  { label: '출발', num: true, render: (r) => gridCell(r.g) },
  { label: '결과', num: true, render: (r) => (r.o === 'F' && r.p <= 3 ? `<b class="podium">${outcome(r)}</b>` : outcome(r)) },
  { label: '상태', cls: 'hide-sm', render: (r) => `<span lang="en">${esc(r.st)}</span>` },
  { label: '점수', num: true, render: (r) => (r.pts ? pts(r.pts) : '0') },
];
const sprintBy = new Map<number, DriverRace[]>();
for (const r of d.sprints) {
  if (!sprintBy.has(r.s)) sprintBy.set(r.s, []);
  sprintBy.get(r.s)!.push(r);
}
const raceBlocks = raceSeasons.map((s) => {
  const list = d.races.filter((r) => r.s === s);
  const row = rows.find((r) => r.s === s)!;
  return { s, list, row, sprints: sprintBy.get(s) ?? [] };
});
const hasZeroGrid = d.races.some((r) => r.g === 0);

const description = `${d.name}의 F1 결승 기록(${span(from, to)}): 챔피언십 순위, 우승과 포디움, 팀 동료 비교, 팀 이력, 대회별 결과`;
---

<BaseLayout title={d.name} description={description} current="drivers">
  <PageHead
    kicker={[`<a href="${routes.drivers()}">드라이버</a>`, esc(d.nationality_ko), nw(span(from, to))]}
    title={en(esc(d.name))}
    lead={M.lead}
    facts={M.facts}
  />
  <Tiles items={M.tiles} />
  {(hasSteps || hasShare || hasPod) && <JsonData id="dr-rows" data={chartRows} />}
  {hasMates && multi && <JsonData id="dr-mates" data={mateData} />}

  {
    hasSteps && (
      <Section id="standings" title="챔피언십 순위" read={reads.st}>
        <Figure
          id="f-steps"
          title="시즌 최종 드라이버 순위"
          scope={`${span(from, to)} · ${rows.length}개 시즌`}
          sub="시즌 마지막 라운드의 드라이버 순위다. 위가 1위다. 출전하지 않은 해와 순위가 없는 시즌에서 선이 끊긴다."
          legend={stepLegend}
          chart="driverSteps"
          dataRef="dr-rows"
          source={SRC_ST}
          asof={ASOF}
          twin={{ caption: '시즌 최종 드라이버 순위', columns: stepCols, rows }}
          notes={[
            { head: '순위 미부여', body: '2001년까지는 무득점 드라이버, 2002년부터는 무득점이면서 완주로 분류된 대회가 없는 드라이버에게 Jolpica가 순위를 매기지 않는다.' },
          ]}
        />
      </Section>
    )
  }

  {
    hasShare && (
      <Section id="share" title="시즌 점수와 1위 대비 비율" read={reads.share}>
        <Figure
          id="f-share"
          title="시즌 점수의 1위 점수 대비 비율"
          scope={`${span(from, to)} · 순위표 점수 ÷ 그 시즌 1위 점수`}
          sub="그 시즌 드라이버 순위표 점수를 같은 시즌 1위의 점수로 나눈 값이다. 우승 점수와 득점 순위 수가 시대마다 달라 점수 자체보다 해끼리 견주기 쉽다. 100%가 챔피언 시즌이다."
          legend={[
            { type: 'rect', color: 's1', label: '1위 점수 대비 비율' },
            ...(d.titles ? [{ type: 'rect' as const, color: 's2', label: '챔피언 시즌 (100%)' }] : []),
          ]}
          chart="driverShare"
          dataRef="dr-rows"
          source={`${SRC_ST}, 비율은 이 사이트 계산`}
          asof={ASOF}
          twin={{ caption: '시즌 점수와 1위 점수 대비 비율', columns: shareCols, rows: chartRows }}
          notes={[
            { head: '순위표 점수', body: '유효 득점 규정(1990년 이전 일부 대회 점수만 인정)과 실격을 반영한 순위표 점수다. 결승 득점 합과 다를 수 있다.' },
          ]}
        />
      </Section>
    )
  }

  {
    hasPod && (
      <Section id="wins" title="우승과 포디움" read={reads.win}>
        <Figure
          id="f-pod"
          title="시즌별 우승과 포디움"
          scope={`${span(from, to)} · 결승만, 스프린트 제외`}
          sub="옅은 막대가 그 시즌 출전 대회 수이고, 그 안에 우승과 2·3위를 쌓았다. 포디움은 완주로 분류된 3위 이내다."
          legend={[
            { type: 'rect', color: 's2', label: '우승' },
            { type: 'rect', color: 's1', label: '2·3위' },
            { type: 'band', label: '출전 대회' },
          ]}
          chart="driverPodiums"
          dataRef="dr-rows"
          source={SRC_RES}
          asof={ASOF}
          twin={{ caption: '시즌별 우승과 포디움', columns: podCols, rows: chartRows }}
        />
      </Section>
    )
  }

  {
    hasMates && (
      <Section id="mates" title="팀 동료 비교" read={reads.mate}>
        {multi && (
        <div class="pair">
          <Figure
            pair
            id="f-mate-r"
            title="결승에서 앞선 횟수와 뒤진 횟수"
            scope={`${span(from, to)} · 시즌마다 동료 전체 합`}
            sub="0선 위가 동료보다 앞선 횟수, 아래가 뒤진 횟수다. 한 대회에 동료가 여럿이면 동료마다 한 번씩 센다. 둘 다 완주로 분류되지 않은 경우는 세지 않는다."
            legend={[
              { type: 'rect', color: 's1', label: '앞섬' },
              { type: 'rect', color: 'ctx', label: '뒤짐' },
            ]}
            chart="mateBars"
            dataRef="dr-mates"
            opts={{ kind: 'race', from, to }}
            source={SRC_RES}
            asof={ASOF}
            twin={{ caption: '시즌별 팀 동료와의 결승 비교', columns: twinMate(false), rows: mateRowsFlat.filter((m) => m.rc > 0) }}
          />
          {
            hasQ ? (
              <Figure
                pair
                id="f-mate-q"
                title="예선에서 앞선 횟수와 뒤진 횟수"
                scope={`${span(qFrom, to)} · 예선 기록이 있는 대회만`}
                sub="0선 위가 동료보다 앞선 횟수, 아래가 뒤진 횟수다. 더 늦은 예선 세션까지 남은 쪽이 앞이고, 같은 세션이면 그 세션 순위로 가른다."
                legend={[
                  { type: 'rect', color: 's1', label: '앞섬' },
                  { type: 'rect', color: 'ctx', label: '뒤짐' },
                ]}
                chart="mateBars"
                dataRef="dr-mates"
                opts={{ kind: 'quali', from: qFrom, to }}
                source={`${JOLPICA} 예선 기록`}
                asof={ASOF}
                twin={{ caption: '시즌별 팀 동료와의 예선 비교', columns: twinMate(true), rows: mateRowsFlat.filter((m) => m.qc > 0) }}
              />
            ) : (
              <div class="empty">
                <p class="empty-title">예선 비교는 0번이다.</p>
                <p>Jolpica 예선 기록은 1994년부터이고 1994년과 1996-2002년은 일부 대회만 있다. 두 드라이버 모두 예선 기록이 있는 대회만 비교한다.</p>
              </div>
            )
          }
        </div>
        )}
        <h3 class="sub-title"><span>동료별 통산</span><span class="sec-meta">{mates.length}명 · 함께한 대회 많은 순</span></h3>
        <DataTable
          caption="팀 동료별 통산 비교"
          columns={mateCols}
          rows={mates}
          expand={mates.length > 12 ? { first: 10, summary: `나머지 ${mates.length - 10}명 보기`, captionRest: '팀 동료별 통산 비교, 나머지' } : undefined}
        />
        <SourceLine source={`${JOLPICA} 결승 결과와 예선 기록, 비교는 이 사이트 계산`} asof={ASOF} />
        <aside class="notes mate-notes" aria-label="팀 동료 비교 정의">
          {
            mateNotes.map((n) => (
              <div class:list={['note', { caution: n.caution }]}>
                <p class="note-h">{n.head}</p>
                <p set:html={n.body} />
              </div>
            ))
          }
        </aside>
      </Section>
    )
  }

  <Section id="teams" title="팀 이력" read={reads.teams}>
    {
      hasTeamChart && (
        <Figure
          id="f-teams"
          title="시즌별 소속 팀"
          scope={`${span(from, to)} · 팀 ${teamRows.length}개`}
          sub="한 칸이 한 시즌이다. 시즌 중에 팀을 옮기면 같은 해에 두 줄이 칠해진다."
          legend={[
            { type: 'rect', color: 's1', label: '출전 시즌' },
            ...(d.titles ? [{ type: 'rect' as const, color: 's2', label: '챔피언 시즌' }] : []),
          ]}
          chart="driverTeams"
          data={teamRows}
          opts={{ from, to }}
          source={SRC_RES}
          asof={ASOF}
          twin={{ caption: '팀별 출전 기간과 기록', columns: teamTwin, rows: teamRows }}
        />
      )
    }
    <h3 class="sub-title"><span>팀 구간</span><span class="sec-meta">{stints.length}개 구간</span></h3>
    <DataTable caption="팀 구간" columns={stintCols} rows={stints} />
    <SourceLine
      source={`${SRC_RES}${linked ? '. 팀 링크는 이 사이트의 계보 표로 2025 그리드 계보에 이은 것' : ''}`}
      asof={ASOF}
    />
  </Section>

  <Section id="seasons" title="시즌별 기록" read={`${rows.length}개 시즌의 출전, 우승, 포디움, 폴, 순위표 점수와 최종 순위다. 시즌을 누르면 그 시즌 쪽으로 간다.`}>
    <DataTable
      caption="시즌별 기록 표"
      columns={seasonCols}
      rows={rows}
      rowClass={(r) => (titleSet.has(r.s) ? 'hl' : '')}
    />
    <SourceLine source={`${SRC_RES}와 ${SRC_ST}`} asof={ASOF} />
    <p class="tbl-note">
      출전은 그 시즌 대회 수 가운데 결승 결과 행이 있는 대회 수다. 점수는 순위표 점수이고 스프린트 점수를 포함한다.
      {d.titles > 0 && ' 바탕색 행이 챔피언 시즌이다.'}
      {dropped.length > 0 && ` 결승과 스프린트 득점 합이 순위표 점수보다 큰 시즌(${dropped.map((r) => r.s).join(', ')})은 유효 득점 규정이나 실격이 반영된 경우다.`}
    </p>
  </Section>

  <Section id="races" title="결승 결과" read={raceSeasons.length > 1 ? `대회별 출발 위치, 결과, 상태, 득점이다. 스크립트가 켜져 있으면 고른 시즌만 보이고, 처음에는 ${latest}년이 보인다.` : `${latest}년 대회별 출발 위치, 결과, 상태, 득점이다.`}>
    {
      raceSeasons.length > 1 && (
        <div class="field race-pick" data-js-only>
          <label for="race-season">시즌</label>
          <select id="race-season">
            {raceSeasons.map((s) => <option value={String(s)} selected={s === latest}>{s}</option>)}
          </select>
        </div>
      )
    }
    {
      raceBlocks.map((blk) => (
        <div class="race-block" data-season={blk.s}>
          <h3 class="sub-title">
            <span>{blk.s} 시즌</span>
            <span class="sec-meta">
              {blk.row.rounds}개 대회 중 {blk.row.entries}회 출전 · 우승 {blk.row.wins}번 · 포디움 {blk.row.podiums}번
            </span>
          </h3>
          <DataTable caption={`${blk.s} 시즌 결승 결과`} columns={raceCols} rows={blk.list} />
          {blk.sprints.length > 0 && (
            <Fragment>
              <p class="mini-label">스프린트 {blk.sprints.length}개</p>
              <DataTable caption={`${blk.s} 시즌 스프린트 결과`} columns={raceCols} rows={blk.sprints} />
            </Fragment>
          )}
        </div>
      ))
    }
    <SourceLine source={`${JOLPICA} 결승과 스프린트 결과`} asof={ASOF} />
    <p class="tbl-note">
      결과의 순위는 완주로 분류된 경우만 적는다. 상태는 Jolpica 원문 표기다.
      {hasZeroGrid && ' 출발 0은 Jolpica가 0으로 적은 경우로 피트 레인 출발이거나 기록이 없는 경우다.'}
    </p>
  </Section>

  <script>
    // 결승 결과 시즌 고르기: 고른 시즌 표만 보인다. 스크립트가 없으면 모든 시즌 표가 차례로 보인다.
    const pick = document.getElementById('race-season') as HTMLSelectElement | null;
    const blocks = [...document.querySelectorAll<HTMLElement>('.race-block[data-season]')];
    if (pick && blocks.length > 1) {
      const show = (s: string) => blocks.forEach((b) => (b.hidden = b.dataset.season !== s));
      show(pick.value);
      pick.addEventListener('change', () => show(pick.value));
    }
  </script>
</BaseLayout>

<style>
  .race-pick {
    max-width: 160px;
    margin-top: var(--sp-4);
  }
  .race-block {
    margin-top: var(--sp-5);
  }
  .race-block[hidden] {
    display: none;
  }
  .race-block :global(.sec-meta),
  :global(#teams h3 .sec-meta),
  :global(#mates h3 .sec-meta) {
    font-size: var(--fs-small);
    color: var(--ink-3);
    font-weight: 400;
  }
  :global(#teams h3.sub-title),
  :global(#mates h3.sub-title) {
    margin-top: var(--sp-6);
  }
  .mini-label {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .tbl-note {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .mate-notes {
    margin-top: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  :global(.dt .of) {
    color: var(--ink-3);
    font-size: var(--fs-micro);
  }
  :global(#mates .pair > .empty) {
    align-self: stretch;
  }
</style>
