---
// 드라이버 쪽 /drivers/<드라이버 ID>/. drivers.json의 모든 드라이버(결승 행이 한 번이라도 있는 817명)마다 하나다.
// 절: 챔피언십 순위, 1위 점수 대비 비율, 우승과 포디움, 결과 분포, 팀 동료 비교, 팀 이력, 시즌별 기록,
// 시즌 상세(시즌을 고르면 대회별 출발과 결과, 라운드 뒤 순위, 대회별 결과 표가 그 시즌으로 바뀐다).
// 자료는 driver/<id>.json과 시즌 JSON(라운드 이름, 라운드 뒤 1위 점수)을 읽는다. 팀 이름은 컨스트럭터 쪽으로 잇는다.
// 시즌이 하나뿐이거나 비교할 값이 0인 절은 그리지 않는다.
import DataTable, { type Column } from '../../components/DataTable.astro';
import Figure from '../../components/Figure.astro';
import JsonData from '../../components/JsonData.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import SourceLine from '../../components/SourceLine.astro';
import Tiles from '../../components/Tiles.astro';
import { causeBars, outcomeCell, posDist } from '../../components/constructor/model.ts';
import { buildDriver, gridCell, pts, span, teamNames, yearsText } from '../../components/driver/model.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { constructorLink } from '../../lib/constructors-data.ts';
import { getSeason } from '../../lib/data.ts';
import { driverLink } from '../../lib/driver-links.ts';
import { driverById, drivers, getDriver, type DriverRace, type DriverSeasonRow } from '../../lib/drivers-data.ts';
import { n0, num } from '../../lib/format.ts';
import { routes } from '../../lib/paths.ts';
import { JOLPICA, asofJolpica } from '../../lib/sources.ts';
import { en, esc, nw } from '../../lib/typeset.ts';

export function getStaticPaths() {
  return drivers.map((d) => ({ params: { id: d.id } }));
}

const { id } = Astro.params as { id: string };
const d = await getDriver(id);
const M = buildDriver(d);
const { rows, chartRows, stints, teamRows, mateSeason, mates, tot, reads, titleSet } = M;
const from = d.first_season;
const to = d.last_season;
const multi = rows.length >= 2;
const SRC_RES = `${JOLPICA} 결승 결과`;
const SRC_ST = `${JOLPICA} 드라이버 순위(시즌 마지막 라운드)`;
const ASOF = asofJolpica();

// ------------------------------------------------------------------ 팀 이름과 계보 링크
const teamCell = (r: DriverSeasonRow) => r.teams.map((t) => constructorLink(t.id, en(esc(t.name)), r.s)).join(', ');
const teamOf = (s: number, c: string) => rows.find((r) => r.s === s)?.teams.find((t) => t.id === c)?.name ?? c;
const posText = (r: DriverSeasonRow) => (r.pos ? `${r.pos}위` : r.excluded ? '실격' : '<span class="muted">미부여</span>');

// ------------------------------------------------------------------ 순위 계단
const hasSteps = multi && M.ranked.length >= 1;
const stepLegend = [
  { type: 'dot' as const, color: 's1', label: '시즌 최종 순위' },
  ...(d.titles ? [{ type: 'dot' as const, color: 's2', label: '챔피언 시즌' }] : []),
  ...(rows.some((r) => r.pos == null) ? [{ type: 'ring' as const, color: 'ctx', label: '순위 미부여 또는 실격 (맨 아래 줄)' }] : []),
];
const stepCols: Column<DriverSeasonRow>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '팀', render: (r) => en(esc(teamNames(r))) },
  { label: '순위', num: true, render: posText },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '') },
  { label: '1위 점수', num: true, render: (r) => pts(r.champ_pts) },
];

// ------------------------------------------------------------------ 1위 점수 대비
const hasShare = multi && chartRows.some((r) => (r.share ?? 0) > 0);
const shareCols: Column<(typeof chartRows)[number]>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '') },
  { label: '1위 점수', num: true, render: (r) => pts(r.cp) },
  { label: '비율', num: true, render: (r) => (r.share != null && !r.ex ? `${num(r.share, 1)}%` : r.ex ? '실격' : '') },
];

// ------------------------------------------------------------------ 우승과 포디움
const hasPod = multi && d.podiums > 0;
const podCols: Column<(typeof chartRows)[number]>[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '출전', num: true, render: (r) => String(r.e) },
  { label: '우승', num: true, render: (r) => String(r.w) },
  { label: '2·3위', num: true, render: (r) => String(r.p - r.w) },
  { label: '포디움', num: true, render: (r) => String(r.p) },
];

// ------------------------------------------------------------------ 결과 분포
const dist = posDist(d.races);
const causes = causeBars(d.races);
const finN = d.races.filter((r) => r.o === 'F').length;
const outN = d.races.length - finN;
const hasDist = d.races.length >= 10 && finN > 0;
const topK = [...dist].sort((a, z) => z.n - a.n)[0];
const distRead = hasDist
  ? `결승 결과 ${n0(d.races.length)}개 가운데 완주로 분류된 결과는 ${n0(finN)}개${outN ? `, 완주하지 못한 결과는 ${n0(outN)}개` : ''}다. 완주 결과에서 가장 많은 순위는 ${typeof topK.k === 'number' ? `${topK.k}위` : esc(String(topK.k))}${`<span class="aside">(${topK.n}번)</span>`}다.${causes.length ? ` 완주하지 못한 결과는 ${causes.map((x) => `${esc(x.name)} ${x.v}번`).join(', ')}이다.` : ''}`
  : '';
const distCols: Column[] = [
  { label: '결과', render: (x) => (typeof x.k === 'number' ? `${x.k}위` : esc(x.k)) },
  { label: '횟수', num: true, render: (x) => String(x.n) },
  { label: '완주 결과 가운데', num: true, render: (x) => (finN ? `${num((x.n / finN) * 100, 1)}%` : '') },
];
const causeCols: Column[] = [
  { label: '결과', render: (x) => esc(x.name) },
  { label: '횟수', num: true, render: (x) => String(x.v) },
];

// ------------------------------------------------------------------ 팀 동료
const hasMates = tot.rc + tot.qc > 0;
const mateRowsFlat = rows.flatMap((r) => r.mates.map((m) => ({ s: r.s, ...m })));
const twinMate = (q: boolean): Column[] => [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '동료', render: (r) => en(esc(r.name)) },
  { label: '팀', render: (r) => en(esc(teamOf(r.s, r.c))) },
  { label: '함께한 대회', num: true, render: (r) => String(r.n) },
  { label: q ? '예선 비교' : '결승 비교', num: true, render: (r) => String(q ? r.qc : r.rc) },
  { label: '앞섬', num: true, render: (r) => String(q ? r.qa : r.ra) },
  { label: '뒤짐', num: true, render: (r) => String(q ? r.qc - r.qa : r.rc - r.ra) },
];
const mateData = mateSeason.map((m) => ({ ...m, mates: m.mates.map(({ id: _i, ...rest }) => rest) }));
const qFrom = Math.max(from, 1994);
const hasQ = tot.qc > 0;
const ratio = (a: number, n: number) => (n ? `${a}:${n - a}` : '<span class="muted">비교 0</span>');
const mateCols: Column[] = [
  { label: '동료', cls: 'stick', render: (m) => driverLink(m.id, en(esc(m.name))) },
  { label: '시즌', render: (m) => nw(yearsText(m.seasons)) },
  { label: '함께한 대회', num: true, cls: 'hide-xs', render: (m) => String(m.n) },
  { label: '결승 앞섬:뒤짐', num: true, render: (m) => ratio(m.ra, m.rc) },
  { label: '예선 앞섬:뒤짐', num: true, render: (m) => ratio(m.qa, m.qc) },
];
const lowQ = rows.filter((r) => r.s >= 1994 && r.s <= 2002 && r.q_cov < r.entries);
const mateNotes = [
  {
    head: '결승 비교',
    body: '같은 대회, 같은 컨스트럭터로 나선 두 드라이버 가운데 완주로 분류된 쪽이 앞이다. 둘 다 분류되면 순위가 작은 쪽이 앞이고, 둘 다 분류되지 않으면 세지 않는다. 리타이어, 실격, 출발하지 않음은 분류되지 않은 쪽이다.',
  },
  {
    head: '예선 비교',
    body: `더 늦은 세션(Q3, Q2, Q1 순)까지 남은 쪽이 앞이고, 같은 세션이면 그 세션 순위로 가른다. 두 드라이버 모두 Jolpica 예선 기록이 있는 대회만 센다(1994년부터).${lowQ.length ? ` ${lowQ.map((r) => r.s).join(', ')}년은 예선 기록이 일부 대회에만 있다.` : ''}`,
  },
  ...(from < 1980
    ? [{ head: '주의', body: '1980년 이전은 참가 팀 구분이 자료에 없어, 같은 섀시를 쓴 다른 참가 팀 드라이버도 동료로 잡힌다. 인디애나폴리스 500은 비교에서 뺀다.', caution: true }]
    : []),
];

// ------------------------------------------------------------------ 팀 이력
const hasTeamChart = teamRows.length >= 2;
const stintCols: Column[] = [
  { label: '기간', render: (s) => nw(span(s.from, s.to)) },
  {
    label: '팀',
    render: (s) => constructorLink(s.c, en(s.names.map((n: string) => esc(n)).join(', '))),
  },
  { label: '시즌', num: true, render: (s) => String(s.seasons.length) },
  { label: '출전', num: true, render: (s) => String(s.e) },
  { label: '우승', num: true, render: (s) => String(s.w) },
  { label: '포디움', num: true, cls: 'hide-xs', render: (s) => String(s.p) },
];
const teamTwin: Column[] = [
  { label: '팀', render: (t) => en(esc(t.name)) },
  { label: '기간', render: (t) => t.span },
  { label: '시즌', num: true, render: (t) => String(t.seasons.length) },
  { label: '출전', num: true, render: (t) => String(t.e) },
  { label: '우승', num: true, render: (t) => String(t.w) },
  { label: '포디움', num: true, render: (t) => String(t.p) },
];


// ------------------------------------------------------------------ 시즌별 기록
const seasonCols: Column<DriverSeasonRow>[] = [
  { label: '시즌', render: (r) => `<a href="${routes.season(r.s)}">${r.s}</a>` },
  { label: '팀', render: teamCell },
  { label: '출전', num: true, render: (r) => `${r.entries}<span class="of">/${r.rounds}</span>` },
  { label: '우승', num: true, render: (r) => String(r.wins) },
  { label: '포디움', num: true, render: (r) => String(r.podiums) },
  { label: '폴', num: true, cls: 'hide-sm', render: (r) => String(r.poles) },
  { label: '점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '<span class="muted">미부여</span>') },
  {
    label: '1위 대비',
    num: true,
    cls: 'hide-sm',
    render: (r) => (r.pts != null && r.champ_pts && !r.excluded ? `${num((r.pts / r.champ_pts) * 100, 1)}%` : ''),
  },
  { label: '순위', num: true, cls: 'pos', render: posText },
];
const dropped = rows.filter((r) => r.pts != null && r.rpts + r.spts - (r.pts as number) > 0.005);

// ------------------------------------------------------------------ 시즌 상세
const raceSeasons = [...new Set(d.races.map((r) => r.s))].sort((a, z) => z - a);
const latest = raceSeasons[0];
const nameOf = (mid: string) => driverById.get(mid)?.name ?? mid;
const raceCols: Column<DriverRace>[] = [
  { label: 'R', num: true, render: (r) => String(r.r) },
  {
    label: '대회',
    render: (r) => `${esc(r.n)}${r.x ? '<span class="sub-line">한 대회에 결과 행이 여럿(차량 공유 또는 교대)</span>' : ''}`,
  },
  { label: '팀', cls: 'hide-xs', render: (r) => constructorLink(r.c, en(esc(teamOf(r.s, r.c))), r.s) },
  { label: '예선', num: true, cls: 'hide-sm', render: (r) => (r.q != null ? String(r.q) : '') },
  { label: '출발', num: true, render: (r) => gridCell(r.g) },
  { label: '결과', num: true, render: (r) => (r.o === 'F' && r.p <= 3 ? `<b class="podium">${outcomeCell(r)}</b>` : outcomeCell(r)) },
  {
    label: '동료',
    cls: 'hide-sm',
    render: (r) =>
      (r.m ?? [])
        .map(([mid, o, p]) => `<span class="nw"><span lang="en">${esc(nameOf(mid).split(' ').slice(-1)[0])}</span> ${o === 'F' ? `${p}위` : o === 'D' ? '실격' : o === 'N' ? '출발 안 함' : '리타이어'}</span>`)
        .join('<br>'),
  },
  { label: '상태', cls: 'hide-sm', render: (r) => `<span lang="en">${esc(r.st)}</span>` },
  { label: '점수', num: true, render: (r) => (r.pts ? pts(r.pts) : '0') },
];
const sprintCols = raceCols.filter((c) => c.label !== '동료' && c.label !== '예선');
const sprintBy = new Map<number, DriverRace[]>();
for (const r of d.sprints) {
  if (!sprintBy.has(r.s)) sprintBy.set(r.s, []);
  sprintBy.get(r.s)!.push(r);
}
const avg = (a: number[]) => (a.length ? num(a.reduce((x, y) => x + y, 0) / a.length, 1) : '');
const raceBlocks = raceSeasons.map((s) => {
  const list = d.races.filter((r) => r.s === s);
  const row = rows.find((r) => r.s === s)!;
  const S = getSeason(s);
  const fin = list.filter((r) => r.o === 'F');
  const qs = list.filter((r) => r.q != null).map((r) => r.q as number);
  const gs = list.filter((r) => r.g > 0).map((r) => r.g);
  const mr = row.mates.reduce((a, m) => ({ ra: a.ra + m.ra, rc: a.rc + m.rc, qa: a.qa + m.qa, qc: a.qc + m.qc }), { ra: 0, rc: 0, qa: 0, qc: 0 });
  const meta = [
    `${row.rounds}개 대회 중 ${row.entries}회 출전`,
    qs.length ? `평균 예선 ${avg(qs)}위` : gs.length ? `평균 출발 ${avg(gs)}위` : '',
    mr.rc ? `동료와 결승 ${mr.ra}:${mr.rc - mr.ra}` : '',
    mr.qc ? `예선 ${mr.qa}:${mr.qc - mr.qa}` : '',
  ].filter(Boolean);
  const stats: [string, string][] = [
    ['최종 순위', row.pos ? `${row.pos}위` : row.excluded ? '실격' : '미부여'],
    ['우승 · 포디움', `${row.wins} · ${row.podiums}`],
    ['평균 결과 (완주)', fin.length ? `${avg(fin.map((r) => r.p))}위` : '완주 없음'],
    ['완주 못 함', `${list.length - fin.length}번`],
  ];
  const lp = S.rounds.map((_, i) => Math.max(0, ...S.drivers.map((x) => x.points?.[i] ?? 0)));
  const steps = S.rounds.map((rd, i) => ({ r: rd.round, n: rd.short_ko, pos: row.round_pos[i] ?? null, pts: row.round_pts[i] ?? null, lp: lp[i] }));
  const strip = list.map((r) => ({
    r: r.r, n: r.n, g: r.g, q: r.q, p: r.p, o: r.o, st: r.st, pts: r.pts, rc: r.rc,
    mates: (r.m ?? []).map(([mid, o, p]) => ({ name: nameOf(mid), o, p })),
  }));
  return { s, list, row, meta, stats, steps, strip, rounds: S.rounds.length, sprints: sprintBy.get(s) ?? [] };
});
const detail = Object.fromEntries(raceBlocks.map((b) => [b.s, { rounds: b.rounds, strip: b.strip, steps: b.steps }]));
const first0 = raceBlocks[0];
const hasZeroGrid = d.races.some((r) => r.g === 0);
const hasSteps0 = raceBlocks.some((b) => b.steps.some((x) => x.pos != null));
const stepCols2: Column[] = [
  { label: 'R', num: true, render: (r) => String(r.r) },
  { label: '대회', render: (r) => esc(r.n) },
  { label: '순위', num: true, render: (r) => (r.pos ? `${r.pos}위` : '') },
  { label: '누적 점수', num: true, render: (r) => (r.pts != null ? pts(r.pts) : '') },
  { label: '1위와 차이', num: true, render: (r) => (r.pts != null ? (r.lp - r.pts > 0.001 ? `−${pts(Math.round((r.lp - r.pts) * 100) / 100)}` : '선두') : '') },
];

const description = `${d.name}의 F1 결승 기록(${span(from, to)}): 챔피언십 순위, 우승과 포디움, 팀 동료 비교, 팀 이력, 대회별 결과`;
---

<BaseLayout title={d.name} description={description} current="drivers">
  <PageHead
    kicker={[`<a href="${routes.drivers()}">드라이버</a>`]}
    title={en(esc(d.name))}
    lead={M.lead}
    facts={M.facts}
  >
    <p class="chips-row cmp-links">
      <a class="chip-link" href={routes.compare('d', [d.id])}>다른 드라이버와 비교</a>
      {
        mates[0] && (
          <a class="chip-link" href={routes.compare('d', [d.id, mates[0].id])}>
            가장 오래 함께한 동료와 비교&nbsp;<span lang="en">({mates[0].name})</span>
          </a>
        )
      }
    </p>
  </PageHead>
  <Tiles items={M.tiles} />
  {(hasSteps || hasShare || hasPod) && <JsonData id="dr-rows" data={chartRows} />}
  {hasMates && multi && <JsonData id="dr-mates" data={mateData} />}

  {
    hasSteps && (
      <Section id="standings" title="챔피언십 순위" read={reads.st}>
        <Figure
          id="f-steps"
          title="시즌 최종 드라이버 순위"
          scope={`${span(from, to)} · ${rows.length}개 시즌`}
          sub="시즌 마지막 라운드의 드라이버 순위다. 위가 1위다. 출전하지 않은 해와 순위가 없는 시즌에서 선이 끊긴다."
          legend={stepLegend}
          chart="driverSteps"
          dataRef="dr-rows"
          source={SRC_ST}
          asof={ASOF}
          twin={{ caption: '시즌 최종 드라이버 순위', columns: stepCols, rows }}
          notes={[
            { head: '순위 미부여', body: '2001년까지는 무득점 드라이버, 2002년부터는 무득점이면서 완주로 분류된 대회가 없는 드라이버에게 Jolpica가 순위를 매기지 않는다.' },
          ]}
        />
      </Section>
    )
  }

  {
    hasShare && (
      <Section id="share" title="시즌 점수와 1위 대비 비율" read={reads.share}>
        <Figure
          id="f-share"
          title="시즌 점수의 1위 점수 대비 비율"
          scope={`${span(from, to)} · 순위표 점수 ÷ 그 시즌 1위 점수`}
          sub="그 시즌 드라이버 순위표 점수를 같은 시즌 1위의 점수로 나눈 값이다. 우승 점수와 득점 순위 수가 시대마다 달라 점수 자체보다 해끼리 견주기 쉽다. 100%가 챔피언 시즌이다."
          legend={[
            { type: 'rect', color: 's1', label: '1위 점수 대비 비율' },
            ...(d.titles ? [{ type: 'rect' as const, color: 's2', label: '챔피언 시즌 (100%)' }] : []),
          ]}
          chart="driverShare"
          dataRef="dr-rows"
          source={`${SRC_ST}, 비율은 이 사이트 계산`}
          asof={ASOF}
          twin={{ caption: '시즌 점수와 1위 점수 대비 비율', columns: shareCols, rows: chartRows }}
          notes={[
            { head: '순위표 점수', body: '유효 득점 규정(1990년 이전 일부 대회 점수만 인정)과 실격을 반영한 순위표 점수다. 결승 득점 합과 다를 수 있다.' },
          ]}
        />
      </Section>
    )
  }

  {
    hasPod && (
      <Section id="wins" title="우승과 포디움" read={reads.win}>
        <Figure
          id="f-pod"
          title="시즌별 우승과 포디움"
          scope={`${span(from, to)} · 결승만, 스프린트 제외`}
          sub="옅은 막대가 그 시즌 출전 대회 수이고, 그 안에 우승과 2·3위를 쌓았다. 포디움은 완주로 분류된 3위 이내다."
          legend={[
            { type: 'rect', color: 's2', label: '우승' },
            { type: 'rect', color: 's1', label: '2·3위' },
            { type: 'band', label: '출전 대회' },
          ]}
          chart="driverPodiums"
          dataRef="dr-rows"
          source={SRC_RES}
          asof={ASOF}
          twin={{ caption: '시즌별 우승과 포디움', columns: podCols, rows: chartRows }}
        />
      </Section>
    )
  }

  {
    hasDist && (
      <Section id="dist" title="결과 분포" read={distRead}>
        <div class="pair">
          <Figure
            pair
            id="f-dist"
            title="완주 순위 분포"
            scope={`${span(from, to)} · 완주로 분류된 결승 결과 ${n0(finN)}개`}
            sub="완주로 분류된 결승 결과가 몇 위였는지 센 막대다. 1위(우승)는 핑크다."
            legend={[
              { type: 'rect', color: 's2', label: '1위' },
              { type: 'rect', color: 's1', label: '2위 이하' },
            ]}
            chart="posBars"
            data={dist}
            opts={{ unit: '번', what: '완주 결과', label: '완주 순위 분포' }}
            source={SRC_RES}
            asof={ASOF}
            twin={{ caption: '완주 순위 분포', columns: distCols, rows: dist }}
          />
          {
            causes.length > 0 ? (
              <Figure
                pair
                id="f-cause"
                title="완주하지 못한 결과"
                scope={`${span(from, to)} · ${n0(outN)}개`}
                sub="완주로 분류되지 않은 결승 결과를 원인 분류별로 센 막대다. 많은 순이 아니라 분류 순서다. 2023년부터는 Jolpica가 리타이어 원인을 적지 않아 원인 미기재로 센다."
                chart="rankBars"
                data={causes}
                opts={{ unit: '번', label: '완주하지 못한 결과', abbr: false }}
                source={`${SRC_RES}의 상태(status), 분류는 이 사이트`}
                asof={ASOF}
                twin={{ caption: '완주하지 못한 결과', columns: causeCols, rows: causes }}
              />
            ) : (
              <div class="empty">
                <p class="empty-title">완주하지 못한 결승 결과는 0개다.</p>
              </div>
            )
          }
        </div>
      </Section>
    )
  }

  {
    hasMates && (
      <Section id="mates" title="팀 동료 비교" read={reads.mate}>
        {multi && (
        <div class="pair">
          <Figure
            pair
            id="f-mate-r"
            title="결승에서 앞선 횟수와 뒤진 횟수"
            scope={`${span(from, to)} · 시즌마다 동료 전체 합`}
            sub="0선 위가 동료보다 앞선 횟수, 아래가 뒤진 횟수다. 한 대회에 동료가 여럿이면 동료마다 한 번씩 센다. 둘 다 완주로 분류되지 않은 경우는 세지 않는다."
            legend={[
              { type: 'rect', color: 's1', label: '앞섬' },
              { type: 'rect', color: 'ctx', label: '뒤짐' },
            ]}
            chart="mateBars"
            dataRef="dr-mates"
            opts={{ kind: 'race', from, to }}
            source={SRC_RES}
            asof={ASOF}
            twin={{ caption: '시즌별 팀 동료와의 결승 비교', columns: twinMate(false), rows: mateRowsFlat.filter((m) => m.rc > 0) }}
          />
          {
            hasQ ? (
              <Figure
                pair
                id="f-mate-q"
                title="예선에서 앞선 횟수와 뒤진 횟수"
                scope={`${span(qFrom, to)} · 예선 기록이 있는 대회만`}
                sub="0선 위가 동료보다 앞선 횟수, 아래가 뒤진 횟수다. 더 늦은 예선 세션까지 남은 쪽이 앞이고, 같은 세션이면 그 세션 순위로 가른다."
                legend={[
                  { type: 'rect', color: 's1', label: '앞섬' },
                  { type: 'rect', color: 'ctx', label: '뒤짐' },
                ]}
                chart="mateBars"
                dataRef="dr-mates"
                opts={{ kind: 'quali', from: qFrom, to }}
                source={`${JOLPICA} 예선 기록`}
                asof={ASOF}
                twin={{ caption: '시즌별 팀 동료와의 예선 비교', columns: twinMate(true), rows: mateRowsFlat.filter((m) => m.qc > 0) }}
              />
            ) : (
              <div class="empty">
                <p class="empty-title">예선 비교는 0번이다.</p>
                <p>Jolpica 예선 기록은 1994년부터이고 1994년과 1996-2002년은 일부 대회만 있다. 두 드라이버 모두 예선 기록이 있는 대회만 비교한다.</p>
              </div>
            )
          }
        </div>
        )}
        <h3 class="sub-title"><span>동료별 통산</span><span class="sec-meta">{mates.length}명 · 함께한 대회 많은 순</span></h3>
        <DataTable
          caption="팀 동료별 통산 비교"
          columns={mateCols}
          rows={mates}
          expand={mates.length > 12 ? { first: 10, summary: `나머지 ${mates.length - 10}명 보기`, captionRest: '팀 동료별 통산 비교, 나머지' } : undefined}
        />
        <SourceLine source={`${JOLPICA} 결승 결과와 예선 기록, 비교는 이 사이트 계산`} asof={ASOF} />
        <aside class="notes mate-notes" aria-label="팀 동료 비교 정의">
          {
            mateNotes.map((n) => (
              <div class:list={['note', { caution: n.caution }]}>
                <p class="note-h">{n.head}</p>
                <p set:html={n.body} />
              </div>
            ))
          }
        </aside>
      </Section>
    )
  }

  <Section id="teams" title="팀 이력" read={reads.teams}>
    {
      hasTeamChart && (
        <Figure
          id="f-teams"
          title="시즌별 소속 팀"
          scope={`${span(from, to)} · 팀 ${teamRows.length}개`}
          sub="한 칸이 한 시즌이다. 시즌 중에 팀을 옮기면 같은 해에 두 줄이 칠해진다."
          legend={[
            { type: 'rect', color: 's1', label: '출전 시즌' },
            ...(d.titles ? [{ type: 'rect' as const, color: 's2', label: '챔피언 시즌' }] : []),
          ]}
          chart="driverTeams"
          data={teamRows}
          opts={{ from, to }}
          source={SRC_RES}
          asof={ASOF}
          twin={{ caption: '팀별 출전 기간과 기록', columns: teamTwin, rows: teamRows }}
        />
      )
    }
    <h3 class="sub-title"><span>팀 구간</span><span class="sec-meta">{stints.length}개 구간</span></h3>
    <DataTable caption="팀 구간" columns={stintCols} rows={stints} />
    <SourceLine source={SRC_RES} asof={ASOF} />
  </Section>

  <Section id="seasons" title="시즌별 기록">
    <DataTable
      caption="시즌별 기록 표"
      columns={seasonCols}
      rows={rows}
      rowClass={(r) => (titleSet.has(r.s) ? 'hl' : '')}
    />
    <SourceLine source={`${SRC_RES}와 ${SRC_ST}`} asof={ASOF} />
    <p class="tbl-note">
      출전은 그 시즌 대회 수 가운데 결승 결과 행이 있는 대회 수다. 점수는 순위표 점수이고 스프린트 점수를 포함한다.
      {d.titles > 0 && ' 바탕색 행이 챔피언 시즌이다.'}
      {dropped.length > 0 && ` 결승과 스프린트 득점 합이 순위표 점수보다 큰 시즌(${dropped.map((r) => r.s).join(', ')})은 유효 득점 규정이나 실격이 반영된 경우다.`}
    </p>
  </Section>

  <Section id="races" title="시즌 상세">
    {
      raceSeasons.length > 1 && (
        <div class="field race-pick" data-js-only>
          <label for="race-season">시즌</label>
          <select id="race-season">
            {raceSeasons.map((s) => <option value={String(s)} selected={s === latest}>{s}</option>)}
          </select>
        </div>
      )
    }
    {
      raceBlocks.map((blk) => (
        <div class="race-block" data-season={blk.s}>
          <h3 class="sub-title">
            <span>
              {blk.s} 시즌 <span class="blk-team" set:html={teamCell(blk.row)} />
            </span>
            <span class="sec-meta">{blk.meta.join(' · ')}</span>
          </h3>
          <dl class="stat-row season-stats">
            {blk.stats.map(([dt, dd]) => (
              <div>
                <dt>{dt}</dt>
                <dd>{dd}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
    <JsonData id="dr-detail" data={detail} />
    <Figure
      id="f-strip"
      title="대회별 출발과 결과"
      scope={`<span data-detail-scope="strip">${latest} · ${first0.rounds}개 대회 · 위가 1위다</span>`}
      sub="한 라운드의 출발과 결과를 세로선으로 잇는다. 선이 길수록 순위를 많이 바꾼 대회다."
      legend={[
        { type: 'ring', color: 's1', label: '출발' },
        { type: 'dot', color: 's2', label: '결과 (완주)' },
        { type: 'times', color: 's2', label: '리타이어 또는 출발 안 함 (맨 아래 줄)' },
        { type: 'hollow', color: 's2', label: '실격 (맨 아래 줄)' },
        { type: 'dot', color: 'ctx', label: '팀 동료의 결과' },
      ]}
      chart="raceStrip"
      data={first0.strip}
      opts={{ rounds: first0.rounds, label: '대회별 출발과 결과' }}
      source={`${JOLPICA} 결승 결과와 예선 기록`}
      asof={ASOF}
      notes={[
        { head: '결과', body: '결과의 순위는 완주로 분류된 경우만 적는다. 리타이어 원인은 Jolpica 상태를 사고·충돌, 차량 문제, 원인 미기재 등으로 묶은 것이다.' },
        { head: '예선과 출발', body: `표의 예선은 최종 예선 순위(1994년부터)이고, 출발은 그리드 페널티가 반영된 결승 출발 순위다.${hasZeroGrid ? ' 출발 0은 Jolpica가 0으로 적은 경우로 피트 레인 출발이거나 기록이 없는 경우다.' : ''}` },
        ...(from < 1980 ? [{ head: '동료', body: '1980년 이전은 참가 팀 구분이 자료에 없어, 같은 섀시를 쓴 다른 참가 팀 드라이버도 동료로 잡힌다. 동료가 3명을 넘는 대회는 동료 결과를 싣지 않는다.', caution: true }] : []),
      ]}
    >
      <Fragment slot="twin">
        {
          raceBlocks.map((blk) => (
            <div data-season-twin={blk.s}>
              <DataTable compact caption={`${blk.s} 시즌 결승 결과`} columns={raceCols} rows={blk.list} />
              {blk.sprints.length > 0 && (
                <Fragment>
                  <p class="mini-label">스프린트 {blk.sprints.length}개</p>
                  <DataTable compact caption={`${blk.s} 시즌 스프린트 결과`} columns={sprintCols} rows={blk.sprints} />
                </Fragment>
              )}
            </div>
          ))
        }
      </Fragment>
    </Figure>
    {
      hasSteps0 && (
        <Figure
          id="f-round"
          title="라운드 뒤 드라이버 순위"
          scope={`<span data-detail-scope="round">${latest} · 라운드가 끝날 때마다 · 위가 1위다</span>`}
          sub="라운드가 끝날 때마다의 Jolpica 드라이버 순위다."
          legend={[
            { type: 'line', color: 's1', label: '라운드 뒤 순위' },
            { type: 'dot', color: 's2', label: '1위였던 라운드' },
          ]}
          chart="roundSteps"
          data={first0.steps}
          opts={{ label: '라운드 뒤 드라이버 순위' }}
          source={`${JOLPICA} 드라이버 순위`}
          asof={ASOF}
        >
          <Fragment slot="twin">
            {
              raceBlocks.map((blk) => (
                <div data-season-twin={blk.s}>
                  <DataTable compact caption={`${blk.s} 시즌 라운드 뒤 드라이버 순위`} columns={stepCols2} rows={blk.steps} />
                </div>
              ))
            }
          </Fragment>
        </Figure>
      )
    }
  </Section>

  <script>
    // 시즌 상세 고르기: 고른 시즌의 머리(통계), 두 차트, 표 보기만 보인다. 스크립트가 없으면 모든 시즌의 머리와 표가 차례로 보인다.
    import { readJson, ready } from '../../lib/charts/mount.ts';

    const pick = document.getElementById('race-season') as HTMLSelectElement | null;
    const blocks = [...document.querySelectorAll<HTMLElement>('.race-block[data-season]')];
    const twins = [...document.querySelectorAll<HTMLElement>('[data-season-twin]')];
    const scope = (k: string) => document.querySelector<HTMLElement>(`[data-detail-scope="${k}"]`);
    if (pick && blocks.length > 1) {
      const show = (s: string) => {
        blocks.forEach((b) => (b.hidden = b.dataset.season !== s));
        twins.forEach((t) => (t.hidden = t.dataset.seasonTwin !== s));
      };
      show(pick.value);
      pick.addEventListener('change', async () => {
        const s = pick.value;
        show(s);
        const data = readJson<Record<string, { rounds: number; strip: unknown[]; steps: unknown[] }>>('dr-detail')[s];
        const st = scope('strip');
        if (st) st.textContent = `${s} · ${data.rounds}개 대회 · 위가 1위다`;
        const rd = scope('round');
        if (rd) rd.textContent = `${s} · 라운드가 끝날 때마다 · 위가 1위다`;
        const handles = await ready;
        handles.get('f-strip')?.redraw(data.strip, { rounds: data.rounds });
        handles.get('f-round')?.redraw(data.steps);
      });
    }
  </script>
</BaseLayout>

<style>
  .race-pick {
    max-width: 160px;
    margin-top: var(--sp-4);
  }
  .race-block {
    margin-top: var(--sp-5);
  }
  .race-block[hidden],
  :global([data-season-twin][hidden]) {
    display: none;
  }
  .blk-team {
    font-weight: 600;
    color: var(--ink-2);
    margin-left: 4px;
  }
  .season-stats {
    margin-bottom: var(--sp-2);
  }
  :global(#f-round) {
    margin-top: var(--sp-6);
  }
  .race-block :global(.sec-meta),
  :global(#teams h3 .sec-meta),
  :global(#mates h3 .sec-meta) {
    font-size: var(--fs-small);
    color: var(--ink-3);
    font-weight: 400;
  }
  :global(#teams h3.sub-title),
  :global(#mates h3.sub-title) {
    margin-top: var(--sp-6);
  }
  .mini-label {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .tbl-note {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .mate-notes {
    margin-top: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  :global(.dt .of) {
    color: var(--ink-3);
    font-size: var(--fs-micro);
  }
  :global(#mates .pair > .empty) {
    align-self: stretch;
  }
</style>
