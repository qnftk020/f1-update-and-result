---
// 드라이버 목록 /drivers/: 1950-2025 결승에 한 번이라도 나선 드라이버 전원.
// 절: 2025 그리드, 타이틀과 우승 순위, 연대별 흐름(챔피언의 우승 비율, 연대 요약 표), 드라이버 찾기(거르기 표).
// 표는 빌드 때 모든 드라이버를 싣는다. 스크립트가 없으면 전체 표가 그대로 보이고, 있으면 거르기와 정렬, 100명씩 보기가 붙는다.
import DataTable, { type Column } from '../../components/DataTable.astro';
import Figure from '../../components/Figure.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import SourceLine from '../../components/SourceLine.astro';
import { span, yearsText } from '../../components/driver/model.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeason, meta } from '../../lib/data.ts';
import { driverById, drivers, history, type DriverSummary } from '../../lib/drivers-data.ts';
import { competitionRanks } from '../../lib/rank.ts';
import { formatPoints, n0, num } from '../../lib/format.ts';
import { aboutRoutes, routes } from '../../lib/paths.ts';
import { JOLPICA, asofJolpica } from '../../lib/sources.ts';
import { aside, b, en, esc, nw } from '../../lib/typeset.ts';

const first = history.first_season;
const last = history.last_season;
const ASOF = asofJolpica();
const link = (id: string, name: string) => `<a href="${routes.driver(id)}" lang="en">${esc(name)}</a>`;

// ------------------------------------------------------------------ 머리
const champs = history.driver_titles;
const maxTitles = champs[0]?.titles ?? 0;
const topChamps = champs.filter((c) => c.titles === maxTitles);
const topWin = history.wins[0];
const winners = drivers.filter((d) => d.wins > 0).length;
const grid = drivers.filter((d) => d.in_2025);
const indy = drivers.filter((d) => d.indy_only).length;
const lead =
  `${first}년부터 ${last}년까지 결승에 한 번 이상 나선 드라이버는 ${b(`${n0(drivers.length)}명`)}이다. ` +
  `${history.seasons.length}번의 드라이버 챔피언십을 ${champs.length}명이 나눠 가졌고, 가장 많은 타이틀은 ${maxTitles}번${aside(topChamps.map((c) => en(esc(c.name))).join(', '))}이다. ` +
  `통산 최다 우승은 ${en(esc(topWin.name))}의 ${b(`${topWin.wins}번`)}이고, 우승을 한 번 이상 한 드라이버는 ${winners}명이다.`;

// ------------------------------------------------------------------ 2025 그리드
const s25 = getSeason(last);
const gridCards = s25.drivers
  .filter((x) => driverById.get(x.id)?.in_2025)
  .map((x) => ({ s: x, d: driverById.get(x.id) as DriverSummary }));

// ------------------------------------------------------------------ 타이틀과 우승 순위
// 경계의 동률은 자르지 않는다: 타이틀 2번 이상, 우승은 20위와 같은 수까지.
const titleList = champs.filter((c) => c.titles >= 2);
const titleData = titleList.map((c) => ({
  id: c.id,
  name: c.name,
  v: c.titles,
  active: Boolean(driverById.get(c.id)?.in_2025),
  sub: [{ value: yearsText(c.seasons), label: '타이틀 시즌' }],
}));
const w20 = history.wins[Math.min(19, history.wins.length - 1)].wins;
const winList = history.wins.filter((w) => w.wins >= w20);
const winData = winList.map((w) => ({
  id: w.id,
  name: w.name,
  v: w.wins,
  active: Boolean(driverById.get(w.id)?.in_2025),
  sub: [
    { value: `${n0(w.starts)}회`, label: '출발' },
    { value: `${num((w.wins / w.starts) * 100, 1)}%`, label: '출발 대비 우승' },
  ],
}));
const barLegend = [
  { type: 'rect' as const, color: 's1', label: `${last} 시즌 미출전` },
  { type: 'rect' as const, color: 's2', label: `${last} 시즌 출전` },
];
const titleRanks = competitionRanks(titleData, (r) => r.v);
const winRanks = competitionRanks(winData, (r) => r.v);
const titleCols: Column[] = [
  { label: '순위', num: true, cls: 'pos', render: (_r, i) => String(titleRanks[i]) },
  { label: '드라이버', render: (r) => en(esc(r.name)) },
  { label: '타이틀', num: true, render: (r) => String(r.v) },
  { label: '시즌', render: (r) => nw(r.sub[0].value) },
];
const winCols: Column[] = [
  { label: '순위', num: true, cls: 'pos', render: (_r, i) => String(winRanks[i]) },
  { label: '드라이버', render: (r) => en(esc(r.name)) },
  { label: '우승', num: true, render: (r) => String(r.v) },
  { label: '출발', num: true, render: (r) => r.sub[0].value },
  { label: '출발 대비', num: true, render: (r) => r.sub[1].value },
];

// ------------------------------------------------------------------ 연대별 흐름
const cw = history.seasons.map((s) => ({ s: s.season, d1: s.d1.name, id: s.d1.id, w: s.d1.wins, n: s.rounds, pct: Math.round((s.d1.wins / s.rounds) * 1000) / 10, hi: false, note: '' as string }));
const topCw = [...cw].sort((a, z) => z.pct - a.pct || z.s - a.s).slice(0, 5);
for (const t of topCw) t.hi = true;
for (const c of cw) if (c.s <= 1960) c.note = '대회 수에 인디애나폴리스 500이 들어 있다.';
const lowCw = [...cw].sort((a, z) => a.pct - z.pct || a.s - z.s)[0];
const cwRead =
  `챔피언이 그 시즌 대회의 몇 퍼센트를 이겼는지를 보면 우승 비율이 가장 높은 시즌은 ${topCw[0].s}년${aside(`${en(esc(topCw[0].d1))}, ${topCw[0].n}개 대회 중 ${topCw[0].w}번`)}이다. ` +
  `가장 낮은 시즌은 ${lowCw.s}년${aside(`${en(esc(lowCw.d1))}, ${lowCw.n}개 대회 중 ${lowCw.w}번`)}이다.`;
const cwCols: Column[] = [
  { label: '시즌', render: (r) => String(r.s) },
  { label: '챔피언', render: (r) => en(esc(r.d1)) },
  { label: '우승', num: true, render: (r) => String(r.w) },
  { label: '대회', num: true, render: (r) => String(r.n) },
  { label: '비율', num: true, render: (r) => `${num(r.pct, 1)}%` },
];

interface Decade {
  dec: number;
  seasons: number;
  races: number;
  winners: Map<string, { name: string; n: number }>;
  champs: Map<string, { name: string; n: number }>;
}
const decs: Decade[] = [];
for (const hs of history.seasons) {
  const dec = Math.floor(hs.season / 10) * 10;
  let g = decs.find((x) => x.dec === dec);
  if (!g) decs.push((g = { dec, seasons: 0, races: 0, winners: new Map(), champs: new Map() }));
  g.seasons += 1;
  const season = getSeason(hs.season);
  g.races += season.rounds.length;
  // 차량 공유 우승은 두 드라이버 모두에게 센다(드라이버 통산 우승과 같은 규칙)
  for (const r of season.rounds) {
    for (const w of new Map(r.winners.map((x) => [x.id, x])).values()) {
      const e = g.winners.get(w.id) ?? { name: w.name, n: 0 };
      e.n += 1;
      g.winners.set(w.id, e);
    }
  }
  const c = g.champs.get(hs.d1.id) ?? { name: hs.d1.name, n: 0 };
  c.n += 1;
  g.champs.set(hs.d1.id, c);
}
const top = (m: Map<string, { name: string; n: number }>) => {
  const list = [...m.entries()].sort((a, z) => z[1].n - a[1].n);
  const max = list[0]?.[1].n ?? 0;
  return { max, who: list.filter((x) => x[1].n === max) };
};
const decRows = decs.map((g) => ({ ...g, tw: top(g.winners), tc: top(g.champs) }));
const decCols: Column[] = [
  { label: '연대', cls: 'pos', render: (r) => nw(`${r.dec}년대`) },
  { label: '대회', num: true, cls: 'hide-xs', render: (r) => String(r.races) },
  { label: '우승자', num: true, render: (r) => `${r.winners.size}명` },
  {
    label: '최다 우승',
    render: (r) => `${r.tw.who.map(([id, x]: [string, { name: string }]) => link(id, x.name)).join(', ')}<span class="sub-line">${r.tw.max}번</span>`,
  },
  { label: '챔피언', num: true, cls: 'hide-sm', render: (r) => `${r.champs.size}명` },
  {
    label: '최다 타이틀',
    render: (r) => `${r.tc.who.map(([id, x]: [string, { name: string }]) => link(id, x.name)).join(', ')}<span class="sub-line">${r.tc.max}번</span>`,
  },
];

// ------------------------------------------------------------------ 드라이버 찾기
const decades = [...new Set(drivers.flatMap((d) => {
  const out: number[] = [];
  for (let y = Math.floor(d.first_season / 10) * 10; y <= d.last_season; y += 10) out.push(y);
  return out;
}))].sort((a, z) => a - z);
const teamsShort = (d: DriverSummary) => {
  const names = d.teams.map((t) => esc(t.name));
  return names.length > 3 ? `${names.slice(0, 3).join(', ')} 외 ${names.length - 3}개` : names.join(', ');
};
const listCols: Column<DriverSummary>[] = [
  {
    label: '드라이버',
    render: (d) =>
      `${link(d.id, d.name)}<span class="sub-line">${esc(d.nationality_ko)}${d.code ? ` · <span class="mono">${esc(d.code)}</span>` : ''}${d.indy_only ? ' · 인디 500만' : ''}</span>`,
  },
  { label: '기간', render: (d) => span(d.first_season, d.last_season) },
  { label: '시즌', num: true, cls: 'hide-sm', render: (d) => String(d.seasons) },
  { label: '출발', num: true, render: (d) => String(d.starts) },
  { label: '우승', num: true, render: (d) => String(d.wins) },
  { label: '포디움', num: true, cls: 'hide-xs', render: (d) => String(d.podiums) },
  { label: '타이틀', num: true, render: (d) => (d.titles ? `<b>${d.titles}</b>` : '0') },
  { label: '최고 순위', num: true, cls: 'hide-sm', render: (d) => (d.best ? `${d.best}위` : '<span class="muted">미부여</span>') },
  { label: '팀', cls: 'hide-sm', render: (d) => `<span lang="en">${teamsShort(d)}</span>` },
];
// 표 본문은 문자열 하나로 만든다(행마다 컴포넌트 속성이 붙지 않게). 거르기 값은 data-*로 둔다:
// f 첫 시즌, l 마지막 시즌, g 2025 출전, t 타이틀, w 우승, p 포디움, s 출발, x 인디 500만, k 검색어(영문 국적).
// 이름, 한국어 국적, 약어, 팀 이름은 스크립트가 행 글자에서 읽는다.
const cellCls = (c: Column<DriverSummary>) => [c.num ? 'num' : '', c.cls ?? ''].filter(Boolean).join(' ');
const listBody = drivers
  .map((d, i) => {
    const tds = listCols.map((c) => `<td${cellCls(c) ? ` class="${cellCls(c)}"` : ''}>${c.render ? c.render(d, i) : ''}</td>`).join('');
    return `<tr data-i="${i}" data-f="${d.first_season}" data-l="${d.last_season}" data-g="${d.in_2025 ? 1 : 0}" data-t="${d.titles}" data-w="${d.wins}" data-p="${d.podiums}" data-s="${d.starts}" data-x="${d.indy_only ? 1 : 0}" data-q="${esc([d.name, d.code ?? '', d.nationality_ko ?? '', d.nationality ?? ''].join(' ').toLowerCase())}">${tds}</tr>`;
  })
  .join('');
---

<BaseLayout title="드라이버" description={`${first}-${last} F1 결승에 나선 드라이버 ${drivers.length}명의 통산 기록, 타이틀과 우승 순위, 연대별 흐름`} current="drivers">
  <PageHead
    kicker={['드라이버', nw(`${first}-${last}`), `${n0(drivers.length)}명`]}
    title="드라이버"
    lead={lead}
    facts={[
      ['드라이버', `${n0(drivers.length)}명`],
      ['드라이버 챔피언', `${champs.length}명`],
      ['우승 경험', `${winners}명`],
      [`${last} 그리드`, `${grid.length}명`],
      ['인디 500만 출전', `${indy}명`],
    ]}
  />

  <Section
    id="grid"
    title={`${last} 그리드`}
    read={`${last} 시즌 결승에 나선 ${gridCards.length}명을 그 시즌 드라이버 순위 순서로 싣는다. 아래 줄은 통산 기록이다.`}
    meta={`<a href="${routes.season(last)}">${last} 시즌 쪽</a>`}
  >
    <ol class="grid-cards">
      {
        gridCards.map(({ s, d }) => (
          <li class:list={['gcard', { champ: s.position === 1 }]}>
            <p class="g-pos">{s.position ? `${s.position}위` : '미부여'} <span>{formatPoints(s.final_points ?? 0)}점</span></p>
            <p class="g-name"><a href={routes.driver(d.id)} lang="en">{d.name}</a></p>
            <p class="g-team" lang="en">{s.team}</p>
            <p class="g-career"><span class="nw">통산 우승 {d.wins}번</span> · <span class="nw">포디움 {d.podiums}번</span> · <span class="nw">타이틀 {d.titles}번</span></p>
          </li>
        ))
      }
    </ol>
    <SourceLine source={`${JOLPICA} 드라이버 순위와 결승 결과`} asof={ASOF} />
  </Section>

  <Section
    id="records"
    title="타이틀과 우승 순위"
    read={`드라이버 챔피언 ${champs.length}명 가운데 타이틀이 2번 이상인 드라이버는 ${titleList.length}명이다. 통산 우승은 20위와 같은 수까지 ${winList.length}명을 싣는다.`}
  >
    <div class="pair">
      <Figure
        pair
        id="f-titles"
        title="통산 드라이버 타이틀"
        scope={`${first}-${last} · 2번 이상 ${titleList.length}명`}
        sub="시즌 마지막 라운드 드라이버 순위 1위 횟수다. 같은 수는 첫 타이틀이 이른 순이다."
        legend={barLegend}
        chart="rankBars"
        data={titleData}
        opts={{ unit: '번', label: '통산 타이틀' }}
        source={`${JOLPICA} 드라이버 순위`}
        asof={ASOF}
        twin={{ caption: '통산 드라이버 타이틀 2번 이상', columns: titleCols, rows: titleData }}
      />
      <Figure
        pair
        id="f-wins"
        title="통산 결승 우승"
        scope={`${first}-${last} · 상위 ${winList.length}명`}
        sub="결승 1위 횟수다. 스프린트는 넣지 않고, 1950년대 차량 공유 우승은 두 드라이버 모두에게 센다."
        legend={barLegend}
        chart="rankBars"
        data={winData}
        opts={{ unit: '번', label: '통산 우승' }}
        source={`${JOLPICA} 결승 결과`}
        asof={ASOF}
        twin={{ caption: '통산 결승 우승 상위', columns: winCols, rows: winData }}
      />
    </div>
  </Section>

  <Section id="eras" title="연대별 흐름" read={cwRead}>
    <Figure
      id="f-cw"
      title="시즌별 챔피언의 우승 비율"
      scope={`${first}-${last} · 챔피언 우승 수 ÷ 그 시즌 대회 수`}
      sub={`막대가 높을수록 그 시즌 챔피언이 대회를 많이 이겼다. 비율이 가장 높은 5개 시즌(${topCw.map((t) => t.s).sort((a, z) => a - z).join(', ')})을 핑크로 칠했다.`}
      legend={[
        { type: 'rect', color: 's1', label: '챔피언의 우승 비율' },
        { type: 'rect', color: 's2', label: '가장 높은 5개 시즌' },
      ]}
      chart="championWins"
      data={cw}
      source={`${JOLPICA} 드라이버 순위와 결승 결과, 비율은 이 사이트 계산`}
      asof={ASOF}
      twin={{ caption: '시즌별 챔피언의 우승 비율', columns: cwCols, rows: cw }}
      notes={[
        { head: '읽는 법', body: '우승 수가 적어도 꾸준히 득점해 챔피언이 된 시즌은 막대가 낮다. 점수 체계와 대회 수가 해마다 달라 비율은 그 시즌 안에서만 뜻이 있다.' },
        { head: '주의', body: '1950-1960년 대회 수에는 챔피언십에 포함된 인디애나폴리스 500이 들어 있어 비율이 실제보다 낮게 나온다.', caution: true },
      ]}
    />
    <h3 class="sub-title"><span>연대 요약</span><span class="sec-meta">{decRows.length}개 연대</span></h3>
    <DataTable caption="연대별 우승자와 챔피언" columns={decCols} rows={decRows} />
    <SourceLine source={`${JOLPICA} 결승 결과와 드라이버 순위`} asof={ASOF} />
  </Section>

  <Section
    id="list"
    title="드라이버 찾기"
    read={`${n0(drivers.length)}명 전원의 통산 기록이다. 기본 정렬은 타이틀, 우승, 포디움, 출발이 많은 순이다. 이름을 누르면 그 드라이버 쪽으로 간다.`}
  >
    <form class="filters drv-filters" id="drv-filters" role="search" aria-label="드라이버 거르기" data-js-only>
      <div class="field">
        <label for="df-q">이름 또는 국적</label>
        <input type="search" id="df-q" placeholder="예: Senna, 브라질" autocomplete="off" />
      </div>
      <div class="field">
        <label for="df-dec">달린 연대</label>
        <select id="df-dec">
          <option value="">전체 연대</option>
          {decades.map((x) => <option value={String(x)}>{x}년대</option>)}
        </select>
      </div>
      <div class="field">
        <label for="df-sort">정렬</label>
        <select id="df-sort">
          <option value="default">타이틀, 우승 순</option>
          <option value="w">우승 많은 순</option>
          <option value="p">포디움 많은 순</option>
          <option value="st">출발 많은 순</option>
          <option value="l">최근 시즌 순</option>
          <option value="n">이름 순</option>
        </select>
      </div>
      <div class="wide-row">
        <label class="chk"><input type="checkbox" id="df-grid" /> {last} 그리드만</label>
        <label class="chk"><input type="checkbox" id="df-champ" /> 챔피언만</label>
        <label class="chk"><input type="checkbox" id="df-win" /> 우승 경험만</label>
        <label class="chk"><input type="checkbox" id="df-indy" /> 인디 500만 출전 제외</label>
        <button class="btn" type="button" id="df-reset">조건 지우기</button>
      </div>
    </form>
    <div class="result-line" aria-live="polite" id="df-result" data-js-only>
      <span class="result-n" id="df-n">{n0(drivers.length)}</span><span class="result-of">{n0(drivers.length)}명 가운데</span>
    </div>
    <div class="tbl-wrap" role="region" tabindex="0" aria-label="드라이버 목록">
      <table class="dt drv-list" id="drv-table">
        <caption class="sr-only">드라이버 목록</caption>
        <thead>
          <tr>{listCols.map((c) => <th scope="col" class:list={[c.num && 'num', c.cls]}>{c.label}</th>)}</tr>
        </thead>
        <tbody set:html={listBody} />
      </table>
    </div>
    <p class="more-row" data-js-only>
      <button class="btn" type="button" id="df-more" hidden>100명 더 보기</button>
    </p>
    <SourceLine source={`${JOLPICA} 결승 결과와 드라이버 순위`} asof={ASOF} />
    <p class="tbl-note">
      출발은 결승 출전 가운데 출발하지 않은 대회를 뺀 수다. Jolpica가 출발하지 못한 일부 경우를 0랩 사고나 실격으로 적어 F1DB와 여러 번(최대 4번) 다를 수 있다. 정의는
      <a href={`${aboutRoutes.methodology()}#drivers`}>방법론</a>에 있다.
    </p>
  </Section>

  <script>
    // 드라이버 찾기: 이름·국적 검색, 연대, 체크 조건, 정렬. 맞는 행 가운데 앞 100명만 보이고 "더 보기"로 늘린다.
    const table = document.getElementById('drv-table');
    const tbody = table?.querySelector('tbody');
    const rows = tbody ? [...tbody.querySelectorAll<HTMLTableRowElement>('tr')] : [];
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const q = $<HTMLInputElement>('df-q');
    const dec = $<HTMLSelectElement>('df-dec');
    const sort = $<HTMLSelectElement>('df-sort');
    const checks = { g: $<HTMLInputElement>('df-grid'), c: $<HTMLInputElement>('df-champ'), w: $<HTMLInputElement>('df-win'), x: $<HTMLInputElement>('df-indy') };
    const nOut = $('df-n');
    const more = $<HTMLButtonElement>('df-more');
    const STEP = 100;
    let limit = STEP;
    const num = (r: HTMLElement, k: string) => Number(r.dataset[k] ?? 0);
    // 검색 대상: 이름, 약어, 한국어와 영어 국적(data-q). 숫자 열과 팀 칸은 찾지 않는다.
    const keys = new Map(rows.map((r) => [r, r.dataset.q ?? '']));
    const names = new Map(rows.map((r) => [r, r.querySelector('a')?.textContent ?? '']));
    const cmp: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      default: (a, b) => num(a, 'i') - num(b, 'i'),
      w: (a, b) => num(b, 'w') - num(a, 'w') || num(a, 'i') - num(b, 'i'),
      p: (a, b) => num(b, 'p') - num(a, 'p') || num(a, 'i') - num(b, 'i'),
      st: (a, b) => num(b, 's') - num(a, 's') || num(a, 'i') - num(b, 'i'),
      l: (a, b) => num(b, 'l') - num(a, 'l') || num(a, 'i') - num(b, 'i'),
      n: (a, b) => (names.get(a) ?? '').localeCompare(names.get(b) ?? '', 'en'),
    };
    let order = 'default';
    const apply = () => {
      if (!tbody) return;
      const term = (q?.value ?? '').trim().toLowerCase();
      const d = dec?.value ? Number(dec.value) : null;
      const s = sort?.value ?? 'default';
      if (s !== order) {
        order = s;
        const sorted = [...rows].sort(cmp[s] ?? cmp.default);
        tbody.append(...sorted);
      }
      let shown = 0;
      let match = 0;
      const list = order === 'default' ? rows : [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];
      for (const r of list) {
        const ok =
          (!term || (keys.get(r) ?? '').includes(term)) &&
          (d == null || (num(r, 'f') <= d + 9 && num(r, 'l') >= d)) &&
          (!checks.g?.checked || r.dataset.g === '1') &&
          (!checks.c?.checked || num(r, 't') > 0) &&
          (!checks.w?.checked || num(r, 'w') > 0) &&
          (!checks.x?.checked || r.dataset.x !== '1');
        if (ok) match += 1;
        const vis = ok && shown < limit;
        if (vis) shown += 1;
        r.hidden = !vis;
      }
      if (nOut) nOut.textContent = match.toLocaleString('ko-KR');
      if (more) {
        more.hidden = match <= shown;
        more.textContent = `${Math.min(STEP, match - shown)}명 더 보기 (보이는 ${shown}명 / ${match}명)`;
      }
    };
    const reset = () => {
      limit = STEP;
      apply();
    };
    q?.addEventListener('input', reset);
    dec?.addEventListener('change', reset);
    sort?.addEventListener('change', reset);
    Object.values(checks).forEach((c) => c?.addEventListener('change', reset));
    more?.addEventListener('click', () => {
      limit += STEP;
      apply();
    });
    $('df-reset')?.addEventListener('click', () => {
      if (q) q.value = '';
      if (dec) dec.value = '';
      if (sort) sort.value = 'default';
      Object.values(checks).forEach((c) => c && (c.checked = false));
      reset();
    });
    $('drv-filters')?.addEventListener('submit', (e) => e.preventDefault());
    apply();
  </script>
</BaseLayout>

