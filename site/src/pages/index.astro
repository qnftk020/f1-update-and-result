---
// 홈: 분석 사이트의 첫 쪽. 최신 대회 결과를 짧게 두고, 부문(연도별, 드라이버, 팀, 업그레이드, 엔진, 규정)마다
// 요약 수치와 작은 그림을 둔 뒤 끝에 전체 쪽 링크를 단다. 문장과 표, 출처 줄은 모두 빌드 때 생성 JSON에서 만든다
// (components/home/home-data.ts, sentences.ts). 브라우저는 그림 셋과 시즌 고르기만 맡는다.
import '../components/home/home.css';
import DataTable, { type Column } from '../components/DataTable.astro';
import Figure from '../components/Figure.astro';
import JsonData from '../components/JsonData.astro';
import LinkPick from '../components/LinkPick.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import Seg from '../components/Seg.astro';
import SourceLine from '../components/SourceLine.astro';
import Tiles from '../components/Tiles.astro';
import {
  catCounts,
  catOrder,
  changed,
  closest,
  counts,
  engineAsOf,
  engineSummary,
  history,
  latestSeason,
  lineageTitles,
  marginData,
  maxWinners,
  mostActive,
  mostActiveLatest,
  perSeason,
  regSummary,
  seasonCards,
  sparkMax,
  sparkSvg,
  teamPoints,
  teamRows,
  tightSeasons,
  titleLeaders,
  top10,
  upgradeSeasons,
  widest,
  winLeaders,
} from '../components/home/home-data.ts';
import { seasonCardHtml } from '../components/home/season-card.ts';
import { finishFact, homeLead, isFinal, ranked, resultsRead, timeText, upgradesRead } from '../components/home/sentences.ts';
import { issueName, SECTION_KO, yearHref } from '../components/regulations/reg-data.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import * as cd from '../lib/chart-data.ts';
import { home, labels, meta } from '../lib/data.ts';
import { formatPoints, josa, n0, pct, posChange } from '../lib/format.ts';
import { badgeHtml, extHtml, glyphHtml } from '../lib/markup.ts';
import { routes } from '../lib/paths.ts';
import { F1DB, FIA_CP, JOLPICA, asofF1db, asofFia, asofJolpica, asofQualiIndex } from '../lib/sources.ts';
import { aside, b, esc, nw } from '../lib/typeset.ts';
import type { ClassificationRow } from '../lib/types.ts';

const h = home;
const race = h.race;
const season = h.season;
const R = `${season} R${race.round}`;
const cl = ranked(h);
const win = cl[0];
const second = cl[1];
const raceLaps = h.race_meta?.laps ?? win?.laps ?? null;
const first = meta.first_season;
const last = meta.last_season;
const dlink = (id: string, name: string) => `<a href="${routes.driver(id)}">${esc(name)}</a>`;

// ---------------------------------------------------------------- 머리
const kicker = ['데이터 요약', nw(`${first}-${last} 시즌`), `최신 대회 ${R} ${esc(race.short_ko)}`];
const regSpan = regSummary ? `${regSummary.first}-${regSummary.last}` : null;
const lead =
  `${first}-${last} 시즌 ${n0(counts.races)}개 대회의 결과와 순위, ` +
  `${upgradeSeasons[0]}-${upgradeSeasons.at(-1)} 업그레이드 항목 ${n0(counts.upgradeItems)}건` +
  (engineSummary ? `, PU 구성요소 사용 현황` : '') +
  (regSpan ? `, ${regSpan}년 규정 문서` : '') +
  `를 부문별로 요약했다. 부문 끝의 링크가 전체 쪽으로 이어진다.`;
const facts: [string, string][] = [
  ['시즌', `${n0(counts.seasons)}개`],
  ['대회', `${n0(counts.races)}개`],
  ['드라이버', `${n0(counts.drivers)}명`],
  ['업그레이드 항목', `${n0(counts.upgradeItems)}건`],
];
const parts = [
  ['latest', '최신 대회'],
  ['by-season', '연도별'],
  ['drivers', '드라이버'],
  ['teams', '팀'],
  ['upgrades', '업그레이드'],
  ['engines', '엔진'],
  ['regulations', '규정'],
].filter(([id]) => (id === 'engines' ? engineSummary : id === 'regulations' ? regSummary : true));

// ---------------------------------------------------------------- 최신 대회
const tiles = [{ label: '우승 기록', value: win?.time ?? '결측', who: win?.name, team: win?.constructor }];
if (second?.time) tiles.push({ label: '우승과 2위 차이', value: timeText(second), who: second.name, team: second.constructor });
if (h.pole?.time) {
  tiles.push({ label: `폴 포지션${h.pole.session ? ` (${h.pole.session})` : ''}`, value: h.pole.time, who: h.pole.name, team: h.pole.constructor });
}
if (h.fastest_lap) {
  tiles.push({ label: `패스티스트 랩 (${h.fastest_lap.lap}랩)`, value: h.fastest_lap.time, who: h.fastest_lap.name, team: h.fastest_lap.constructor });
}
const raceMeta = [
  isFinal(h) ? '최종전' : `${race.round}라운드`,
  raceLaps ? `결승 ${raceLaps}랩` : '',
  h.race_meta?.wet ? '우천 결승' : '마른 노면 결승',
  `완주 ${finishFact(h)}`,
]
  .filter(Boolean)
  .join(' · ');

const resultCols: Column<ClassificationRow>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) =>
      `<span class="who">${dlink(r.id, r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}` +
      `${r.fastest_lap ? '<span class="fl" title="결승 패스티스트 랩">FL</span>' : ''}</span>` +
      `<span class="sub-line show-sm">${esc(r.constructor)}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.constructor) },
  { label: '출발', num: true, cls: 'hide-xs', render: (r) => (r.grid ? String(r.grid) : '피트 출발') },
  { label: '기록, 차이', num: true, render: (r) => esc(timeText(r)) },
  { label: '점수', num: true, render: (r) => (r.points == null ? '' : n0(r.points)) },
];
const breakTop3 = (r: { position?: number | null }) => (r.position === 3 ? 'break' : '');

const grid = cd.gridFinishData(h);
const gridTwin = {
  caption: '출발 순위와 결승 순위',
  columns: [
    { label: '결승', num: true, render: (r: (typeof grid)[number]) => String(r.pos) },
    { label: '드라이버', render: (r: (typeof grid)[number]) => esc(r.name) },
    { label: '출발', num: true, render: (r: (typeof grid)[number]) => String(r.grid) },
    { label: '순위 변화', num: true, render: (r: (typeof grid)[number]) => posChange(r.grid as number, r.pos as number) },
  ],
  rows: grid,
};

// ---------------------------------------------------------------- 연도별
const latestCard = seasonCards.find((c) => c.s === last) ?? seasonCards[seasonCards.length - 1];
const years = seasonCards.map((c) => c.s).sort((a, b) => b - a);
const decades = [...new Set(years.map((y) => Math.floor(y / 10) * 10))];
const yearGroups = decades.map((d) => ({
  label: `${d}년대`,
  links: years.filter((y) => Math.floor(y / 10) * 10 === d).sort((a, b) => a - b).map((y) => ({ href: routes.season(y), text: String(y), current: y === last })),
}));
const seasonRead =
  `${first}-${last} 시즌 ${n0(history.seasons.length)}개 가운데 드라이버 1위와 2위의 점수 차이가 1위 점수의 5% 미만인 시즌은 ${b(`${tightSeasons.length}개`)}다. ` +
  `가장 근소한 시즌은 ${b(`${closest.season}년`)}${aside(`${formatPoints(closest.margin)}점, ${formatPoints(closest.margin_pct)}%`)}이고, ` +
  `차이가 가장 큰 시즌은 ${b(`${widest.season}년`)}${aside(`${formatPoints(widest.margin_pct)}%`)}이다. ` +
  `서로 다른 우승자가 가장 많이 나온 시즌은 ${maxWinners.season}년${aside(`${maxWinners.winners}명`)}이다.`;
type M = (typeof marginData)[number];
const marginTwin = {
  caption: '시즌별 1위와 2위의 점수 차',
  columns: [
    { label: '시즌', num: true, render: (r: M) => `<a href="${routes.season(r.s)}">${r.s}</a>` },
    { label: '드라이버 1위', render: (r: M) => `<span lang="en">${esc(r.d1)}</span>` },
    { label: '2위', cls: 'hide-sm', render: (r: M) => `<span lang="en">${esc(r.d2)}</span>` },
    { label: '차이 (점)', num: true, render: (r: M) => formatPoints(r.dm) },
    { label: '1위 대비 (%)', num: true, render: (r: M) => r.d.toFixed(2) },
    { label: '컨스트럭터 차이 (점)', num: true, cls: 'hide-sm', render: (r: M) => (r.cm == null ? '순위 없음' : formatPoints(r.cm)) },
    { label: '1위 대비 (%)', num: true, cls: 'hide-sm', render: (r: M) => (r.c == null ? '순위 없음' : r.c.toFixed(2)) },
  ],
  rows: [...marginData].reverse(),
  rowClass: (r: M) => (r.s === last ? 'hl' : ''),
};

// ---------------------------------------------------------------- 드라이버
const champ = history.seasons.find((s) => s.season === last)!;
const champRow = top10[0];
const driverRead =
  `${last} 시즌 드라이버 1위는 ${b(esc(champ.d1.name))}${aside(esc(champ.d1.teams.join(', ')))}의 ${formatPoints(champ.d1.pts)}점이고, ` +
  `2위 ${esc(champ.d2.name)}의 ${formatPoints(champ.d2.pts)}점과 ${b(`${formatPoints(champ.margin)}점`)} 차이다.` +
  (champ.lead_change && champ.lead_change > 1
    ? ` 순위 선두는 ${champ.lead_change}라운드에 마지막으로 바뀌었고, 1위가 선두였던 라운드는 ${champ.d1.led}개다.`
    : ` 1위가 선두였던 라운드는 ${champ.d1.led}개다.`) +
  ` 역대 최다 우승은 ${esc(winLeaders[0].name)}의 ${winLeaders[0].wins}승이다.`;
type T = (typeof top10)[number];
const top10Cols: Column<T>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) => `<span class="who">${dlink(r.id, r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}</span><span class="sub-line show-sm">${esc(r.team)}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.team) },
  { label: '승', num: true, cls: 'hide-xs', render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => formatPoints(r.points) },
  {
    label: '라운드별 순위',
    cls: 'hm-spark-cell',
    render: (r) => `${sparkSvg(r.positions, sparkMax, 96, 28)}<span class="sr-only">최고 ${r.best}위, 최저 ${r.worst}위, 최종 ${r.position}위</span>`,
  },
  { label: '선두 라운드 수', num: true, cls: 'hide-sm', render: (r) => String(r.led) },
];
const maxTitles = titleLeaders[0]?.titles || 1;
const maxWins = winLeaders[0]?.wins || 1;
const bar = (v: number, max: number) => `<span class="bar" aria-hidden="true"><span style="width:${((v / max) * 100).toFixed(1)}%"></span></span>`;

// ---------------------------------------------------------------- 팀
type TR = (typeof teamRows)[number];
const cmax = teamRows[0]?.points || 1;
const teamCols: Column<TR>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '팀',
    render: (r) =>
      `<span class="who">${r.lineage_id ? `<a href="${routes.team(r.lineage_id)}" lang="en">${esc(r.name)}</a>` : `<span lang="en">${esc(r.name)}</span>`}</span>` +
      (r.name_ko ? `<span class="sub-line">${esc(r.name_ko)}</span>` : ''),
  },
  { label: '승', num: true, cls: 'hide-xs', render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => formatPoints(r.points) },
  { label: '<span class="sr-only">점수 막대</span>', labelHtml: true, cls: 'meter-cell hide-sm', render: (r) => `<span class="meter" style="width:${((r.points / cmax) * 100).toFixed(1)}%" aria-hidden="true"></span>` },
  {
    label: '예선 평균 지수',
    num: true,
    render: (r) => (r.q == null ? '결측' : `${pct(r.q)}<span class="sub-line">${r.qRank}위</span>`),
  },
];
const qBest = [...teamRows].filter((r) => r.q != null).sort((a, z) => (a.q as number) - (z.q as number))[0];
const c1 = teamRows[0];
const c2 = teamRows[1];
const teamRead =
  `${last} 컨스트럭터 1위 ${b(esc(c1.name))}의 ${formatPoints(c1.points)}점은 2위 ${esc(c2.name)}보다 ${b(`${formatPoints(c1.points - c2.points)}점`)} 많다. ` +
  (qBest ? `시즌 예선 평균 지수가 가장 작은 팀은 ${esc(qBest.name)} 팀${aside(pct(qBest.q))}이다. ` : '') +
  `점수 순위와 예선 지수 순위가 같은 팀은 ${teamRows.filter((r) => r.qRank === r.position).length}개다.`;
const hlTeams = teamPoints.slice(0, 3);
const rounds = cd.roundLabels(latestSeason);
const ptsCell = (v: number | null) => (v == null ? '' : formatPoints(v));
const maxLineageTitles = lineageTitles[0]?.titles || 1;

// ---------------------------------------------------------------- 업그레이드
const catTotal = catOrder.reduce((a, c) => a + catCounts[c], 0);
const share = (n: number) => (catTotal ? (n / catTotal) * 100 : 0);
const shareText = (n: number) => {
  const s = share(n);
  return s > 0 && s < 1 ? '1% 미만' : `${Math.round(s)}%`;
};
const topCat = [...catOrder].sort((a, z) => catCounts[z] - catCounts[a])[0];
const topLabel = labels.reason_categories[topCat];
const upRead =
  `${upgradeSeasons[0]}-${upgradeSeasons.at(-1)} FIA 문서 ${n0(counts.upgradeDocs)}건에서 항목 ${n0(counts.upgradeItems)}건을 읽었다. ` +
  `변경 사유는 ${topLabel}${aside(shareText(catCounts[topCat]))}${josa(topLabel, '이', '가').slice(topLabel.length)} 가장 많다.`;

// ---------------------------------------------------------------- 엔진
const E = engineSummary;
const engineRead = E
  ? `${E.season} 시즌 PU 공급사는 ${E.suppliers.length}곳이고 ${E.teams}개 팀에 PU를 댔다. ` +
    (E.iceAllowed != null ? `ICE 허용 개수(${E.iceAllowed}개)를 넘긴 드라이버는 ${E.drivers}명 가운데 ${b(`${E.iceOver}명`)}이다.` : '')
  : '';
const supMax = E ? Math.max(...E.suppliers.map((p) => p.teams.length)) : 1;
const engineAsof = `${asofF1db()}, 문서 ${engineAsOf ? `${nw(engineAsOf)} 수집` : '수집일 기록 부재'}`;

// ---------------------------------------------------------------- 규정
const RS = regSummary;
const regRead = RS
  ? `${RS.first}-${RS.last}년 ${RS.years}개 연도의 기술 규정과 스포팅 규정 문서를 모았다. ` +
    `아래 바뀐 조항 수는 ${RS.year - 1}년과 ${RS.year}년의 마지막으로 파싱한 판을 조항 단위로 비교한 값이다.`
  : '';

const description = `${first}-${last} 시즌 연도별 1위, 드라이버와 팀 순위, 업그레이드 항목, PU 사용 현황, 규정 변경을 부문별로 요약하고 ${season} 시즌 ${isFinal(h) ? '최종전' : `${race.round}라운드`} 결과를 보인다`;
---

<BaseLayout description={description} current="home">
  <PageHead kicker={kicker} title="부문별 데이터 요약" lead={lead} facts={facts}>
    <nav class="chips-row hm-parts" aria-label="이 쪽의 부문">
      {parts.map(([id, label]) => <a class="chip-link" href={`#${id}`}>{label}</a>)}
    </nav>
  </PageHead>

  <Section id="latest" title="최신 대회" meta={`${R} · <span class="nw">${race.date}</span> · <span lang="en">${esc(race.circuit)}</span>`}>
    <h3 class="sub-title hm-race-title">
      <span>{race.name_ko}<span class="latin" lang="en">{race.name}</span></span>
      <span class="sec-meta">{raceMeta}</span>
    </h3>
    <p class="read" set:html={`${homeLead(h)} ${resultsRead(h)}`} />
    <Tiles items={tiles} />
    <div class="pair">
      <div>
        <h4 class="sr-only">결승 순위표</h4>
        <DataTable
          caption="결승 결과 1위부터 10위"
          columns={resultCols}
          rows={cl}
          rowClass={breakTop3}
          expand={{ first: 10, summary: `11위부터 ${cl.length}위까지 보기`, captionRest: `결승 결과 11위부터 ${cl.length}위` }}
        />
        <SourceLine source={`${JOLPICA} 결승 결과. FL은 결승 패스티스트 랩이다`} asof={asofJolpica()} />
      </div>
      <Figure
        pair
        id="f-grid"
        title="출발 순위와 결승 순위"
        scope={`${R} · ${grid.length}대`}
        sub="블루 빈 원이 출발, 핑크 채운 원이 결승 순위다. 왼쪽일수록 앞 순위이고, 5칸 이상 바뀐 차에만 변화량을 적었다."
        legend={[
          { type: 'ring', color: 's1', label: '출발 (그리드)' },
          { type: 'dot', color: 's2', label: '결승' },
        ]}
        chart="gridToFinish"
        data={grid}
        source={`${JOLPICA} 결승 결과(그리드, 순위)`}
        asof={asofJolpica()}
        twin={gridTwin}
      />
    </div>
    <p class="hm-more hm-split">
      <a href={routes.season(season)}>{season} 시즌 캘린더와 순위 추이</a>
      <a href={`${routes.season(season)}#pace`}>팀 페이스 지수 추이</a>
    </p>
  </Section>

  <Section id="by-season" title="연도별" read={seasonRead} meta={`<a href="${routes.seasons()}">${first}-${last} 시즌 목록</a>`}>
    <div class="pair">
      <div>
        <div class="ev-picker hm-picker" data-js-only>
          <div class="field">
            <label for="hm-year">시즌 고르기</label>
            <select id="hm-year">
              {
                decades.map((d) => (
                  <optgroup label={`${d}년대`}>
                    {years
                      .filter((y) => Math.floor(y / 10) * 10 === d)
                      .map((y) => (
                        <option value={String(y)} selected={y === last}>
                          {y}
                        </option>
                      ))}
                  </optgroup>
                ))
              }
            </select>
          </div>
          <div class="field">
            <span class="lab" aria-hidden="true">&nbsp;</span>
            <button class="btn" type="button" id="hm-prev">이전 시즌</button>
          </div>
          <div class="field">
            <span class="lab" aria-hidden="true">&nbsp;</span>
            <button class="btn" type="button" id="hm-next" aria-disabled="true">다음 시즌</button>
          </div>
        </div>
        <div class="hm-nojs">
          <LinkPick summary="다른 시즌 쪽으로 가기" navLabel="시즌 목록" groups={yearGroups} />
        </div>
        <div class="hm-card" id="hm-card" aria-live="polite" set:html={seasonCardHtml(latestCard, history.constructor_first_season)} />
        <SourceLine source={`${JOLPICA} 최종 순위와 결승 결과, 이 사이트 집계`} asof={asofJolpica()} />
      </div>
      <div>
        <div class="hm-kind">
          <Seg
            label="점수 차이를 볼 순위"
            attr="kind"
            id="hm-kind"
            items={[
              { value: 'd', label: '드라이버', pressed: true },
              { value: 'c', label: '컨스트럭터' },
            ]}
          />
        </div>
        <Figure
          pair
          id="f-margins"
          title="1위와 2위의 점수 차"
          scope={`${first}-${last} · <span id="hm-kind-scope">드라이버 순위</span> · 1위 점수 대비 %`}
