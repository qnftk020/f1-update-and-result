---
// 홈: 최신 대회 결과 요약, 그 주말에 제출된 업그레이드, 페이스 스냅샷, 최종 순위.
// DESIGN.md "와이어프레임 > 홈"과 design/final/home.html을 따른다. 문장과 표, 출처 줄은 모두 빌드 때
// home.json에서 만들고(components/home/sentences.ts), 브라우저는 네 그림만 그린다(BaseLayout의 mountAll).
import DataTable, { type Column } from '../components/DataTable.astro';
import Figure from '../components/Figure.astro';
import Note from '../components/Note.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import SourceLine from '../components/SourceLine.astro';
import Tiles from '../components/Tiles.astro';
import UpgradeItem from '../components/UpgradeItem.astro';
import {
  cautionExample,
  finishFact,
  homeLead,
  isFinal,
  latestLine,
  paceRead,
  qualiSurface,
  qualiSurfaceShort,
  raceRows,
  ranked,
  resultsRead,
  roundNote,
  standingsRead,
  teamsByName,
  thisWeekendLine,
  timeText,
  upgradesRead,
} from '../components/home/sentences.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import * as cd from '../lib/chart-data.ts';
import { home, labels, meta } from '../lib/data.ts';
import { formatLapTime, n0, num, posChange, range2 } from '../lib/format.ts';
import { badgeHtml, extHtml } from '../lib/markup.ts';
import { routes } from '../lib/paths.ts';
import { FIA_CP, JOLPICA, OPENF1, OPENF1_LICENSE, asofFia, asofJolpica, asofQualiIndex, asofRaceIndex } from '../lib/sources.ts';
import { esc, nw } from '../lib/typeset.ts';
import type { ClassificationRow } from '../lib/types.ts';

const h = home;
const race = h.race;
const season = h.season;
const R = `${season} R${race.round}`;
const cl = ranked(h);
const win = cl[0];
const second = cl[1];
const classified = cl.filter((c) => c.classified).length;
const raceLaps = h.race_meta?.laps ?? win?.laps ?? null;

// ---------------------------------------------------------------- 머리
const kicker = [
  '최신 대회',
  `${season} 시즌 ${race.round}라운드${isFinal(h) ? ' · 최종전' : ''}`,
  nw(race.date),
  `<span lang="en">${esc(race.circuit)}</span>`,
];
const facts: [string, string][] = [
  ['예선 노면', qualiSurface(h)],
  ['결승 노면', h.race_meta?.wet ? '우천' : '마른 노면'],
];
if (raceLaps) facts.push(['결승', `${raceLaps}랩`]);
facts.push(['완주', finishFact(h)]);

// ---------------------------------------------------------------- 결승 결과
const tiles = [
  { label: '우승 기록', value: win?.time ?? '결측', who: win?.name, team: win?.constructor },
];
if (second?.time) tiles.push({ label: '우승과 2위 차이', value: timeText(second), who: second.name, team: second.constructor });
if (h.pole?.time) {
  tiles.push({
    label: `폴 포지션${h.pole.session ? ` (${h.pole.session})` : ''}`,
    value: h.pole.time,
    who: h.pole.name,
    team: h.pole.constructor,
  });
}
if (h.fastest_lap) {
  tiles.push({
    label: `패스티스트 랩 (${h.fastest_lap.lap}랩)`,
    value: h.fastest_lap.time,
    who: h.fastest_lap.name,
    team: h.fastest_lap.constructor,
  });
}

const resultCols: Column<ClassificationRow>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) =>
      `<span class="who">${esc(r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}` +
      `${r.fastest_lap ? '<span class="fl" title="결승 패스티스트 랩">FL</span>' : ''}</span>` +
      `<span class="sub-line show-sm">${esc(r.constructor)}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.constructor) },
  { label: '출발', num: true, cls: 'hide-xs', render: (r) => (r.grid ? String(r.grid) : '피트 출발') },
  { label: '기록, 차이', num: true, render: (r) => esc(timeText(r)) },
  { label: '점수', num: true, render: (r) => (r.points == null ? '' : n0(r.points)) },
];
const breakTop3 = (r: { position?: number | null }) => (r.position === 3 ? 'break' : '');

const grid = cd.gridFinishData(h);
const gridTwin = {
  caption: '출발 순위와 결승 순위',
  columns: [
    { label: '결승', num: true, render: (r: (typeof grid)[number]) => String(r.pos) },
    { label: '드라이버', render: (r: (typeof grid)[number]) => esc(r.name) },
    { label: '출발', num: true, render: (r: (typeof grid)[number]) => String(r.grid) },
    { label: '순위 변화', num: true, render: (r: (typeof grid)[number]) => posChange(r.grid as number, r.pos as number) },
  ],
  rows: grid,
};

// ---------------------------------------------------------------- 제출된 업그레이드
const now = h.upgrades_this_weekend;
const last = h.upgrades_latest;
const showLatest = Boolean(last && (!now || last.season !== now.season || last.round !== now.round));
const counts = h.round_counts;
const teamCount = now?.teams.length ?? last?.teams.length ?? 10;
const statusText = (t: { status: string; items: number }) =>
  t.status === 'updates' ? `항목 ${n0(t.items)}건` : (labels.team_status[t.status] ?? t.status);
const roundsTwin = {
  caption: `${season} 시즌 라운드별 업그레이드 항목 수`,
  columns: [
    { label: '라운드', num: true, render: (r: (typeof counts)[number]) => String(r.round) },
    {
      label: '대회',
      render: (r: (typeof counts)[number]) => `${esc(r.name_ko)}${r.review ? ` ${badgeHtml('review', '검수 대기')}` : ''}`,
    },
    { label: '항목', num: true, render: (r: (typeof counts)[number]) => `${n0(r.n)}건` },
  ],
  rows: counts,
};
const roundsLegend: { type: 'rect' | 'ring' | 'nodoc'; color?: string; label: string }[] = [
  { type: 'rect', color: 's1', label: '항목 수' },
  { type: 'rect', color: 's2', label: '가장 많은 대회' },
  { type: 'ring', color: 'ink-3', label: '신고 0건' },
];
if (counts.length < h.rounds_in_season) roundsLegend.push({ type: 'nodoc', label: '문서 부재' });

// ---------------------------------------------------------------- 페이스
const qualiRows = h.quali;
const qualiTwin = {
  caption: '퀄리파잉 페이스 지수',
  columns: [
    { label: '팀', render: (r: (typeof qualiRows)[number]) => esc(r.constructor) },
    { label: '지수 (%)', num: true, render: (r: (typeof qualiRows)[number]) => num(r.v, 3) },
    { label: '차이 (초)', num: true, render: (r: (typeof qualiRows)[number]) => (r.gap_s == null ? '결측' : `+${num(r.gap_s, 3)}`) },
    { label: '팀 최고 랩', num: true, render: (r: (typeof qualiRows)[number]) => (r.team_best_ms == null ? '결측' : formatLapTime(r.team_best_ms)) },
  ],
  rows: qualiRows,
};
const rr = h.race_index;
const raceTwin = {
  caption: '레이스 페이스 지수와 95% 구간',
  columns: [
    { label: '팀', render: (r: (typeof rr)[number]) => esc(r.constructor) },
    { label: '지수 (%)', num: true, render: (r: (typeof rr)[number]) => num(r.v, 2, { sign: true }) },
    { label: '95% 구간', num: true, render: (r: (typeof rr)[number]) => (r.v == null ? '결측' : range2(r.lo, r.hi)) },
    { label: '클린 랩', num: true, render: (r: (typeof rr)[number]) => (r.laps == null ? '결측' : String(r.laps)) },
  ],
  rows: rr,
};
const hasRace = raceRows(h).length > 0;

// ---------------------------------------------------------------- 최종 순위
const drv = h.drivers;
const con = h.constructors;
const dmax = drv[0]?.points || 1;
const cmax = con[0]?.points || 1;
const meter = (v: number, max: number) => `<span class="meter" style="width:${((v / max) * 100).toFixed(1)}%" aria-hidden="true"></span>`;
const driverCols: Column<(typeof drv)[number]>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) =>
      `<span class="who">${esc(r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}</span>` +
      `<span class="sub-line show-sm">${esc(r.team ?? '')}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.team ?? '') },
  { label: '승', num: true, render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => n0(r.points) },
  { label: '', cls: 'meter-cell hide-sm', render: (r) => meter(r.points, dmax) },
];
const conCols: Column<(typeof con)[number]>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  { label: '팀', render: (r) => esc(r.name) },
  { label: '승', num: true, render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => n0(r.points) },
  { label: '', cls: 'meter-cell hide-sm', render: (r) => meter(r.points, cmax) },
];

const description = `${season} 시즌 ${isFinal(h) ? '최종전' : `${race.round}라운드`} 결과, 그 주말에 제출된 업그레이드, 팀별 페이스 지수와 ${isFinal(h) ? '최종' : '현재'} 순위`;
---

<BaseLayout description={description} current="home">
  <PageHead kicker={kicker} title={esc(race.name_ko)} latin={race.name} lead={homeLead(h)} facts={facts} />

  <Section id="results" title="결승 결과" read={resultsRead(h)} meta={`${raceLaps ? `${raceLaps}랩 · ` : ''}${classified}대 완주`}>
    <Tiles items={tiles} />
    <div class="pair">
      <div>
        <h3 class="sr-only">결승 순위표</h3>
        <DataTable
          caption="결승 결과 1위부터 10위"
          columns={resultCols}
          rows={cl}
          rowClass={breakTop3}
          expand={{ first: 10, summary: `11위부터 ${cl.length}위까지 보기`, captionRest: `결승 결과 11위부터 ${cl.length}위` }}
        />
        <SourceLine source={`${JOLPICA} 결승 결과. FL은 결승 패스티스트 랩이다`} asof={asofJolpica()} />
      </div>
      <Figure
        pair
        id="f-grid"
        title="출발 순위와 결승 순위"
        scope={`${R} · ${grid.length}대`}
        sub="블루 빈 원이 출발, 핑크 채운 원이 결승 순위다. 왼쪽일수록 앞 순위이고, 5칸 이상 바뀐 차에만 변화량을 적었다."
        legend={[
          { type: 'ring', color: 's1', label: '출발 (그리드)' },
          { type: 'dot', color: 's2', label: '결승' },
        ]}
        chart="gridToFinish"
        data={grid}
        source={`${JOLPICA} 결승 결과(그리드, 순위)`}
        asof={asofJolpica()}
        twin={gridTwin}
      />
    </div>
  </Section>

  <Section
    id="upgrades"
    title="제출된 업그레이드"
    read={upgradesRead(h)}
    meta={`<a href="${routes.upgrades()}">업그레이드 탐색기에서 ${n0(meta.counts.upgrade_items)}건 모두 보기</a>`}
  >
    {
      now && (
        <div class="sub">
          <h3 class="sub-title">
            <span>이번 대회: {now.round}라운드 {now.event_short_ko}</span>
            <span class="sec-meta">
              {now.published_at && <Fragment>문서 게시 <span class="nw">{now.published_at.slice(0, 10)}</span> · </Fragment>}
              <Fragment set:html={extHtml(now.url)} />
            </span>
          </h3>
          {now.review && <p class="read" set:html={`${badgeHtml('review', '검수 대기 문서')} 자동으로 읽지 못한 쪽이 있어 사람이 확인하기 전까지 일부 팀 항목이 비어 있다.`} />}
          <p class="read" style="font-size:var(--fs-table)" set:html={thisWeekendLine(h)} />
          <ul class="team-status" aria-label="팀별 제출 상태">
            {teamsByName(now).map((t) => (
              <li>
                <span lang="en">{t.team}</span>
                <span>{statusText(t)}</span>
              </li>
            ))}
          </ul>
          {now.list.length > 0 && (
            <div class="items" style="margin-top:var(--sp-3)">
              {now.list.map((item) => <UpgradeItem item={item} />)}
            </div>
          )}
        </div>
      )
    }
    {
      showLatest && last && (
        <div class="sub">
          <h3 class="sub-title">
            <span>가장 최근 신고: {last.round}라운드 {last.event_short_ko}</span>
            <span class="sec-meta">
              {last.published_at && <Fragment>문서 게시 <span class="nw">{last.published_at.slice(0, 10)}</span> · </Fragment>}
              <Fragment set:html={extHtml(last.url)} />
            </span>
          </h3>
          <div class="items" style="margin-top:var(--sp-3)">
            {last.list.map((item) => <UpgradeItem item={item} />)}
          </div>
          <p class="muted" style="font-size:var(--fs-small);margin-top:8px" set:html={latestLine(last)} />
        </div>
      )
    }
    {
      counts.length > 0 && (
        <Figure
          id="f-rounds"
          title={`${season} 시즌 라운드별 업그레이드 항목 수`}
          scope={`${teamCount}개 팀 합계 · 문서 ${counts.length}건`}
          sub={`신고된 항목 수다. 빈 원은 ${teamCount}개 팀 모두 <span lang="en">No updates submitted</span>로 제출한 대회다.`}
          legend={roundsLegend}
          chart="roundCounts"
          data={cd.roundCountData(h)}
          opts={{ rounds: h.rounds_in_season }}
          source={`${FIA_CP} ${season} 문서 ${counts.length}건, 이 사이트 파싱`}
          asof={asofFia()}
          twin={roundsTwin}
          notes={[
            { head: '읽는 법', body: roundNote(h) },
            { head: '주의', body: '항목 수가 많다고 성능 변화가 크다는 뜻은 아니다. 항목의 크기와 성능 영향은 문서에 적혀 있지 않다.', caution: true },
          ]}
        />
      )
    }
  </Section>

  <Section id="pace" title="페이스 스냅샷" read={paceRead(h)} meta="두 지수는 기준점이 다르다">
    <div class="pair">
      <Figure
        pair
        id="f-quali"
        title="퀄리파잉 페이스 지수"
        scope={`${R} · 본 예선 Q1~Q3 · ${qualiSurfaceShort(h)}`}
        sub="팀 최고 랩이 세션 최고 랩보다 몇 % 느렸는지다. 0이 가장 빠른 팀이고 왼쪽이 빠르다."
        chart="qualifyingRank"
        data={cd.qualiRankData(h)}
        source={`${JOLPICA} 예선 기록(Q1~Q3), 이 사이트 계산`}
        asof={asofQualiIndex()}
        twin={qualiTwin}
      />
      {
        hasRace && (
          <Figure
            pair
            id="f-race"
            title="레이스 페이스 지수와 95% 구간"
            scope={`${R} · 결승 클린 랩 · 95% 구간`}
            sub="연료 보정한 클린 랩 중앙값을 필드 중앙값과 비교한 값이다. 음수가 빠르고 왼쪽이 빠르다."
            legend={[
              { type: 'dot', color: 's1', label: '지수' },
              { type: 'line', color: 's1', label: '95% 구간' },
              { type: 'line', color: 'ink-3', label: '필드 중앙값 (0)' },
            ]}
            chart="raceIntervals"
            data={cd.raceIntervalData(h)}
            source={`${OPENF1} 랩, 스틴트, 레이스 컨트롤 (${OPENF1_LICENSE}), 이 사이트 계산(부트스트랩 1,000회)`}
            asof={asofRaceIndex()}
            twin={raceTwin}
          />
        )
      }
    </div>
    <div class="fig-row wide" style="margin-top:var(--sp-4)">
      <aside class="notes" aria-label="페이스 주석">
        <Note
          head="읽는 법"
          body="퀄리파잉 지수는 세션 최고 랩 대비, 레이스 지수는 필드 중앙값 대비다. 기준점이 달라 같은 팀의 두 값을 나란히 비교하지 않는다."
        />
        {hasRace && <Note head="주의" caution body={cautionExample(h)} />}
        {
          hasRace && (
            <Note
              head="연료 보정 가정"
              body="0.03초/kg과 출발 연료 110kg은 관행값이다(미검증). 같은 대회의 팀끼리 나눈 값이라 오차가 대부분 상쇄된다."
            />
          )
        }
      </aside>
    </div>
  </Section>

  <Section id="standings" title={isFinal(h) ? '최종 순위' : '순위'} read={standingsRead(h)} meta="막대는 1위 점수 대비">
    <div class="pair">
      <div>
        <h3 class="sub-title"><span>드라이버</span><span class="sec-meta">상위 10명 · {h.standings_round}라운드 종료</span></h3>
        <DataTable
          caption="드라이버 최종 순위 1위부터 10위"
          columns={driverCols}
          rows={drv}
          rowClass={breakTop3}
          expand={{ first: 10, summary: `11위부터 ${drv.length}위까지 보기`, captionRest: '드라이버 최종 순위 11위부터' }}
        />
        <SourceLine source={`${JOLPICA} 드라이버 순위`} asof={asofJolpica()} />
      </div>
      <div>
        <h3 class="sub-title"><span>컨스트럭터</span><span class="sec-meta">{con.length}개 팀</span></h3>
        <DataTable caption="컨스트럭터 최종 순위" columns={conCols} rows={con} rowClass={breakTop3} />
        <SourceLine source={`${JOLPICA} 컨스트럭터 순위`} asof={asofJolpica()} />
      </div>
    </div>
  </Section>
</BaseLayout>
