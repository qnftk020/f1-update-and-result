<script>
  import { seasonCardHtml, type CardRow } from '../components/home/season-card.ts';

  // 연도별 시즌 고르기. 스크립트가 없으면 고르기가 숨고 최신 시즌 칸과 시즌 링크 목록이 보인다.
  const src = document.getElementById('hm-seasons');
  const card = document.getElementById('hm-card');
  const sel = document.getElementById('hm-year') as HTMLSelectElement | null;
  const prev = document.getElementById('hm-prev') as HTMLButtonElement | null;
  const next = document.getElementById('hm-next') as HTMLButtonElement | null;
  const kindBtns = [...document.querySelectorAll<HTMLButtonElement>('#hm-kind [data-kind]')];
  const kindScope = document.getElementById('hm-kind-scope');
  if (src && card && sel && prev && next) {
    const { first, cards } = JSON.parse(src.textContent || '{}') as { first: number; cards: CardRow[] };
    const byYear = new Map(cards.map((c) => [c.s, c]));
    const minY = cards[0].s;
    const maxY = cards[cards.length - 1].s;
    let year = Number(sel.value) || maxY;
    let kind = 'd';
    let redraw: ((d: unknown, o: Record<string, unknown>) => void) | null = null;
    const show = (y: number, from?: 'chart') => {
      const c = byYear.get(y);
      if (!c) return;
      year = y;
      card.innerHTML = seasonCardHtml(c, first);
      sel.value = String(y);
      prev.setAttribute('aria-disabled', String(y <= minY));
      next.setAttribute('aria-disabled', String(y >= maxY));
      if (redraw) redraw(null, { selected: y });
      if (from === 'chart') card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    sel.addEventListener('change', () => show(Number(sel.value)));
    prev.addEventListener('click', () => year > minY && show(year - 1));
    next.addEventListener('click', () => year < maxY && show(year + 1));
    kindBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        kind = btn.dataset.kind || 'd';
        kindBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (kindScope) kindScope.textContent = kind === 'c' ? '컨스트럭터 순위' : '드라이버 순위';
        if (redraw) redraw(null, { kind });
      }),
    );
    import('../lib/charts/mount.ts')
      .then((m) => m.ready)
      .then((handles) => {
        const hd = handles.get('f-margins');
        if (!hd) return;
        redraw = (d, o) => hd.redraw(d ?? undefined, o);
        hd.redraw(undefined, { selected: year, kind, onSelect: (y: number) => show(y, 'chart') });
      })
      .catch(() => {
        /* 차트가 없어도 고르기는 움직인다 */
      });
  }
</script>
