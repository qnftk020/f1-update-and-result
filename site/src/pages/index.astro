---
// 홈(DESIGN.md "홈"): 데이터베이스의 첫 페이지. 사이트 이름과 범위 한 줄, 검색 칸, 최신 대회 결과 표, 시즌 연도 표,
// 드라이버·팀 기록 표, 업그레이드·엔진·규정 요약 표 순이다. 서술 문단과 큰 숫자 칸을 두지 않는다.
// 표와 출처 줄은 빌드 때 생성 JSON에서 만든다(components/home/home-data.ts).
import '../components/home/home.css';
import DataTable, { type Column } from '../components/DataTable.astro';
import Figure from '../components/Figure.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import SourceLine from '../components/SourceLine.astro';
import Tiles from '../components/Tiles.astro';
import {
  catCounts,
  catOrder,
  changed,
  counts,
  engineAsOf,
  engineSummary,
  history,
  latestSeason,
  lineageTitles,
  perSeason,
  regSummary,
  sparkMax,
  sparkSvg,
  teamPoints,
  teamRows,
  teams,
  titleLeaders,
  top10,
  winLeaders,
} from '../components/home/home-data.ts';
import { finishFact, isFinal, ranked, timeText } from '../components/home/sentences.ts';
import { issueName, SECTION_KO, yearHref } from '../components/regulations/reg-data.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import * as cd from '../lib/chart-data.ts';
import { home, labels, meta, seasons } from '../lib/data.ts';
import { formatPoints, n0, pct, posChange } from '../lib/format.ts';
import { badgeHtml, extHtml, glyphHtml } from '../lib/markup.ts';
import { routes } from '../lib/paths.ts';
import { F1DB, FIA_CP, JOLPICA, asofF1db, asofFia, asofJolpica, asofQualiIndex } from '../lib/sources.ts';
import { esc, nw } from '../lib/typeset.ts';
import type { ClassificationRow } from '../lib/types.ts';

const h = home;
const race = h.race;
const season = h.season;
const R = `${season} R${race.round}`;
const cl = ranked(h);
const win = cl[0];
const second = cl[1];
const raceLaps = h.race_meta?.laps ?? win?.laps ?? null;
const first = meta.first_season;
const last = meta.last_season;
const dlink = (id: string, name: string) => `<a href="${routes.driver(id)}">${esc(name)}</a>`;

// ---------------------------------------------------------------- 머리
const scope = `${first}-${last} · 시즌 ${n0(counts.seasons)}개 · 대회 ${n0(counts.races)}개 · 드라이버 ${n0(counts.drivers)}명 · 업그레이드 항목 ${n0(counts.upgradeItems)}건`;

// ---------------------------------------------------------------- 최신 대회
const tiles = [{ label: '우승 기록', value: win?.time ?? '미상', who: win?.name, team: win?.constructor }];
if (second?.time) tiles.push({ label: '우승과 2위 차이', value: timeText(second), who: second.name, team: second.constructor });
if (h.pole?.time) {
  tiles.push({ label: `폴 포지션${h.pole.session ? ` (${h.pole.session})` : ''}`, value: h.pole.time, who: h.pole.name, team: h.pole.constructor });
}
if (h.fastest_lap) {
  tiles.push({ label: `패스티스트 랩 (${h.fastest_lap.lap}랩)`, value: h.fastest_lap.time, who: h.fastest_lap.name, team: h.fastest_lap.constructor });
}
const raceMeta = [
  isFinal(h) ? '최종전' : `${race.round}라운드`,
  raceLaps ? `결승 ${raceLaps}랩` : '',
  h.race_meta?.wet ? '우천 결승' : '마른 노면 결승',
  `완주 ${finishFact(h)}`,
]
  .filter(Boolean)
  .join(' · ');

const resultCols: Column<ClassificationRow>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) =>
      `<span class="who">${dlink(r.id, r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}` +
      `${r.fastest_lap ? '<span class="fl" title="결승 패스티스트 랩">FL</span>' : ''}</span>` +
      `<span class="sub-line show-sm">${esc(r.constructor)}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.constructor) },
  { label: '출발', num: true, cls: 'hide-xs', render: (r) => (r.grid ? String(r.grid) : '피트 출발') },
  { label: '기록, 차이', num: true, render: (r) => esc(timeText(r)) },
  { label: '점수', num: true, render: (r) => (r.points == null ? '' : n0(r.points)) },
];
const breakTop3 = (r: { position?: number | null }) => (r.position === 3 ? 'break' : '');

const grid = cd.gridFinishData(h);
const gridTwin = {
  caption: '출발 순위와 결승 순위',
  columns: [
    { label: '결승', num: true, render: (r: (typeof grid)[number]) => String(r.pos) },
    { label: '드라이버', render: (r: (typeof grid)[number]) => esc(r.name) },
    { label: '출발', num: true, render: (r: (typeof grid)[number]) => String(r.grid) },
    { label: '순위 변화', num: true, render: (r: (typeof grid)[number]) => posChange(r.grid as number, r.pos as number) },
  ],
  rows: grid,
};

// ---------------------------------------------------------------- 시즌
const decades = [...new Set(seasons.map((x) => Math.floor(x.season / 10) * 10))].sort((a, z) => z - a);
type SeasonRow = (typeof seasons)[number];
const recent = [...seasons].sort((a, z) => z.season - a.season).slice(0, 10);
const champCols: Column<SeasonRow>[] = [
  { label: '시즌', render: (r) => `<a href="${routes.season(r.season)}">${r.season}</a>` },
  { label: '대회', num: true, render: (r) => String(r.rounds) },
  { label: '드라이버 챔피언', render: (r) => (r.champion_driver ? `<a href="${routes.driver(r.champion_driver.id)}" lang="en">${esc(r.champion_driver.name)}</a>` : '') },
  { label: '컨스트럭터 챔피언', render: (r) => (r.champion_constructor ? `<a href="${routes.constructorPage(r.champion_constructor.id)}" lang="en">${esc(r.champion_constructor.name)}</a>` : '<span class="muted">1958년부터</span>') },
];

// ---------------------------------------------------------------- 드라이버
type T = (typeof top10)[number];
const top10Cols: Column<T>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '드라이버',
    render: (r) => `<span class="who">${dlink(r.id, r.name)}${r.code ? `<span class="code">${esc(r.code)}</span>` : ''}</span><span class="sub-line show-sm">${esc(r.team)}</span>`,
  },
  { label: '팀', cls: 'hide-sm', render: (r) => esc(r.team) },
  { label: '승', num: true, cls: 'hide-xs', render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => formatPoints(r.points) },
  {
    label: '라운드별 순위',
    cls: 'hm-spark-cell hide-xs',
    render: (r) => `${sparkSvg(r.positions, sparkMax, 96, 22)}<span class="sr-only">최고 ${r.best}위, 최저 ${r.worst}위, 최종 ${r.position}위</span>`,
  },
];
type L = (typeof titleLeaders)[number];
const titleCols: Column<L>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.rank) },
  { label: '드라이버', render: (r) => dlink(r.id, r.name) },
  { label: '기간', cls: 'hide-xs', render: (r) => `${r.first_season}-${r.last_season}` },
  { label: '타이틀', num: true, render: (r) => `${r.titles}` },
];
type W = (typeof winLeaders)[number];
const winCols: Column<W>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.rank) },
  { label: '드라이버', render: (r) => dlink(r.id, r.name) },
  { label: '출발', num: true, cls: 'hide-xs', render: (r) => n0(r.starts) },
  { label: '우승', num: true, render: (r) => `${r.wins}` },
];

// ---------------------------------------------------------------- 팀
type TR = (typeof teamRows)[number];
const teamCols: Column<TR>[] = [
  { label: '순위', cls: 'pos', render: (r) => String(r.position) },
  {
    label: '컨스트럭터',
    render: (r) => `<a href="${routes.constructorPage(r.id)}" lang="en">${esc(r.name)}</a>`,
  },
  { label: '팀 계보', cls: 'hide-sm', render: (r) => (r.lineage_id && r.name_ko ? `<a href="${routes.team(r.lineage_id)}">${esc(r.name_ko)}</a>` : '') },
  { label: '승', num: true, cls: 'hide-xs', render: (r) => n0(r.wins) },
  { label: '점수', num: true, render: (r) => formatPoints(r.points) },
  { label: '예선 평균 지수', num: true, cls: 'hide-xs', render: (r) => (r.q == null ? '미상' : pct(r.q)) },
];
type LT = (typeof lineageTitles)[number];
const lineageCols: Column<LT>[] = [
  { label: '팀 계보', render: (r) => `<a href="${routes.team(r.lineage_id)}">${esc(r.name_ko)}</a>` },
  { label: '마지막 타이틀', num: true, render: (r) => String(r.title_seasons.at(-1) ?? '') },
  { label: '타이틀', num: true, render: (r) => String(r.titles) },
];
const hlTeams = teamPoints.slice(0, 3);
const rounds = cd.roundLabels(latestSeason);
const ptsCell = (v: number | null) => (v == null ? '' : formatPoints(v));

// ---------------------------------------------------------------- 업그레이드
const catTotal = catOrder.reduce((a, c) => a + catCounts[c], 0);
const shareText = (n: number) => {
  const s = catTotal ? (n / catTotal) * 100 : 0;
  return s > 0 && s < 1 ? '1% 미만' : `${Math.round(s)}%`;
};

// ---------------------------------------------------------------- 엔진
const E = engineSummary;
const engineAsof = `${asofF1db()}, 문서 ${engineAsOf ? `${nw(engineAsOf)} 수집` : '수집일 기록 부재'}`;

// ---------------------------------------------------------------- 규정
const RS = regSummary;

const description = `${first}-${last} F1 기록 데이터베이스: 시즌, 드라이버, 컨스트럭터, 팀 계보, 차체 업그레이드 항목, PU 사용 현황, 규정 문서. ${season} 시즌 ${isFinal(h) ? '최종전' : `${race.round}라운드`} 결과.`;
---

<BaseLayout description={description} current="home">
  <PageHead title="F1 업그레이드와 성능 추이" meta={scope} crumbs={false}>
    <form class="hm-search" role="search" action={routes.search()} method="get">
      <label class="sr-only" for="hm-q">드라이버, 팀, 시즌, 대회 검색</label>
      <input id="hm-q" name="q" type="search" placeholder="이름, 약어, 연도, 대회 (예: Senna, HAM, 1988 모나코, 워킹)" autocomplete="off" />
      <button class="btn" type="submit">검색</button>
    </form>
    <p class="chips-row hm-lists">
      <a class="chip-link" href={routes.seasons()}>시즌 {n0(counts.seasons)}개</a>
      <a class="chip-link" href={routes.drivers()}>드라이버 {n0(counts.drivers)}명</a>
      <a class="chip-link" href={routes.constructors()}>컨스트럭터</a>
      <a class="chip-link" href={routes.teams()}>팀 계보 {teams.length}개</a>
      <a class="chip-link" href={routes.upgrades()}>업그레이드 {n0(counts.upgradeItems)}건</a>
      {E && <a class="chip-link" href={routes.engines()}>엔진</a>}
      {RS && <a class="chip-link" href={routes.regulations()}>규정</a>}
    </p>
  </PageHead>

  <Section id="latest" title={`최신 대회: ${R} ${race.name_ko}`} meta={`<span class="nw">${race.date}</span> · <span lang="en">${esc(race.circuit)}</span> · ${raceMeta}`}>
    <Tiles items={tiles} caption="최신 대회 기록" />
    <div class="pair">
      <div>
        <DataTable
          caption="결승 결과 1위부터 10위"
          columns={resultCols}
          rows={cl}
          rowClass={breakTop3}
          expand={{ first: 10, summary: `11위부터 ${cl.length}위까지 보기`, captionRest: `결승 결과 11위부터 ${cl.length}위` }}
        />
        <SourceLine source={`${JOLPICA} 결승 결과. FL은 결승 패스티스트 랩이다`} asof={asofJolpica()} />
      </div>
      <Figure
        pair
        id="f-grid"
        title="출발 순위와 결승 순위"
        scope={`${R} · ${grid.length}대`}
        legend={[
          { type: 'ring', color: 's1', label: '출발 (그리드)' },
          { type: 'dot', color: 's2', label: '결승' },
        ]}
        chart="gridToFinish"
        data={grid}
        source={`${JOLPICA} 결승 결과(그리드, 순위)`}
        asof={asofJolpica()}
        twin={gridTwin}
      />
    </div>
    <p class="chips-row">
      <a class="chip-link" href={`${routes.season(season)}#r${race.round}`}>{season} 시즌 캘린더</a>
      <a class="chip-link" href={`${routes.season(season)}#pace`}>{season} 팀 페이스 지수</a>
    </p>
  </Section>

  <Section id="seasons" title="시즌" meta={`<a href="${routes.seasons()}">${first}-${last} 시즌 목록</a>`}>
    <div class="pair">
      <div>
        <div class="tbl-wrap" role="region" tabindex="0" aria-label="연대별 시즌">
          <table class="dt hm-years">
            <caption class="sr-only">연대별 시즌</caption>
            <thead><tr><th scope="col">연대</th><th scope="col">시즌</th></tr></thead>
            <tbody>
              {
                decades.map((d) => (
                  <tr>
                    <th scope="row">{d}년대</th>
                    <td>
                      <div class="hm-yrs">
                        {seasons
                          .filter((x) => Math.floor(x.season / 10) * 10 === d)
                          .sort((a, z) => a.season - z.season)
                          .map((x) => <a href={routes.season(x.season)}>{x.season}</a>)}
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <DataTable caption={`최근 ${recent.length}개 시즌의 챔피언`} columns={champCols} rows={recent} />
        <SourceLine source={`${JOLPICA} 시즌 최종 순위`} asof={asofJolpica()} />
      </div>
    </div>
  </Section>

  <Section id="drivers" title="드라이버" meta={`<a href="${routes.drivers()}">드라이버 ${n0(counts.drivers)}명</a>`}>
    <h3 class="sub-title"><span>{last} 드라이버 순위 1-10위</span></h3>
    <DataTable caption={`${last} 드라이버 최종 순위 1위부터 10위와 라운드별 순위`} columns={top10Cols} rows={top10} rowClass={breakTop3} />
    <SourceLine source={`${JOLPICA} 드라이버 순위(라운드별)`} asof={asofJolpica()} />
    <div class="pair">
      <div>
        <h3 class="sub-title"><span>드라이버 챔피언 타이틀</span><span class="sec-meta">{first}-{last}</span></h3>
        <DataTable caption="드라이버 챔피언 타이틀 상위" columns={titleCols} rows={titleLeaders} />
      </div>
      <div>
        <h3 class="sub-title"><span>결승 우승</span><span class="sec-meta">{first}-{last}</span></h3>
        <DataTable caption="결승 우승 상위" columns={winCols} rows={winLeaders} />
      </div>
    </div>
    <SourceLine source={`${JOLPICA} 결승 결과와 시즌 최종 순위, 이 사이트 집계. 같은 값은 같은 등수다`} asof={asofJolpica()} />
  </Section>

  <Section id="teams" title="컨스트럭터와 팀 계보" meta={`<a href="${routes.constructors()}">컨스트럭터 목록</a> · <a href="${routes.teams()}">팀 계보 ${teams.length}개</a>`}>
    <div class="pair">
      <div>
        <h3 class="sub-title"><span>{last} 컨스트럭터 순위</span></h3>
        <DataTable caption={`${last} 컨스트럭터 최종 순위와 예선 평균 지수`} columns={teamCols} rows={teamRows} rowClass={breakTop3} />
        <SourceLine source={`${JOLPICA} 컨스트럭터 순위, 예선 평균 지수는 마른 예선의 팀 최고 랩 기준 이 사이트 계산`} asof={asofQualiIndex()} />
      </div>
      <div>
        <h3 class="sub-title"><span>팀 계보별 컨스트럭터 타이틀</span><span class="sec-meta">{history.constructor_first_season}-{last}</span></h3>
        <DataTable caption="계보별 컨스트럭터 타이틀" columns={lineageCols} rows={lineageTitles} />
        <SourceLine source={`${JOLPICA} 컨스트럭터 최종 순위, 이 사이트의 계보 자료. 브래클리 계보에는 Tyrrell 1971과 Brawn 2009가 들어 있다`} asof={asofJolpica()} />
      </div>
    </div>
    <Figure
      id="f-cons"
      title="컨스트럭터 누적 점수"
      scope={`${last} · 라운드별 누적 · 강조 ${hlTeams.length}팀`}
      legend={[
        ...hlTeams.map((c, k) => ({ type: 'line' as const, color: ['s1', 's2', 's3'][k], label: esc(c.label) })),
        { type: 'line' as const, color: 'ctx', label: '나머지 팀' },
      ]}
      chart="pointsRace"
      data={teamPoints}
      opts={{ rounds, highlight: hlTeams.map((c) => c.id), unit: '점' }}
      source={`${JOLPICA} 컨스트럭터 순위(라운드별)`}
      asof={asofJolpica()}
      twin={{
        caption: `${last} 컨스트럭터 라운드별 누적 점수`,
        columns: [
          { label: '순위', num: true, render: (r) => String(r.pos) },
          { label: '팀', cls: 'stick', render: (r) => `<span lang="en">${esc(r.label)}</span>` },
          ...Array.from({ length: rounds.length }, (_, i): Column => ({ label: String(i + 1), num: true, render: (r) => ptsCell(r.pts[i]) })),
        ],
        rows: teamPoints,
      }}
    />
  </Section>

  <div class="hm-briefs">
    <Section id="upgrades" title="업그레이드" meta={`<a href="${routes.upgrades()}">${n0(counts.upgradeItems)}건 보기</a>`}>
      <div class="tbl-wrap" role="region" tabindex="0" aria-label="시즌별 업그레이드 항목">
        <table class="dt">
          <caption class="sr-only">시즌별 업그레이드 항목과 문서</caption>
          <thead><tr><th scope="col">시즌</th><th scope="col" class="num">문서</th><th scope="col" class="num">항목</th></tr></thead>
          <tbody>
            {perSeason.map((x) => <tr><td>{x.season}</td><td class="num">{n0(x.docs)}</td><td class="num">{n0(x.n)}</td></tr>)}
          </tbody>
        </table>
      </div>
      <ul class="share-list">
        {
          catOrder.map((c) => (
            <li>
              <Fragment set:html={glyphHtml(c)} />
              <span class="share-name">{labels.reason_categories[c]}</span>
              <b class="share-n">{n0(catCounts[c])}건</b>
              <span class="share-p">{shareText(catCounts[c])}</span>
            </li>
          ))
        }
      </ul>
      <SourceLine source={`${FIA_CP} 문서 ${n0(counts.upgradeDocs)}건, 이 사이트 추출`} asof={asofFia()} />
    </Section>

    {
      E && (
        <Section id="engines" title={`엔진 ${E.season}`} meta={`<a href="${routes.engines()}">PU 사용 현황</a>`}>
          <div class="tbl-wrap" role="region" tabindex="0" aria-label={`${E.season} PU 공급사`}>
            <table class="dt">
              <caption class="sr-only">{E.season} PU 공급사별 팀</caption>
              <thead><tr><th scope="col">PU 공급사</th><th scope="col">팀</th></tr></thead>
              <tbody>
                {E.suppliers.map((x) => (
                  <tr>
                    <td lang="en">{x.name}</td>
                    <td lang="en">{x.teams.map((t) => t.team).join(', ')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <dl class="stat-row">
            <div><dt>ICE 허용</dt><dd>{E.iceAllowed ?? '미상'}개</dd></div>
            <div><dt>허용 초과</dt><dd>{E.iceOver}/{E.drivers}명</dd></div>
            <div><dt>새 ICE</dt><dd>{n0(E.iceEvents)}건</dd></div>
          </dl>
          <SourceLine source={`${F1DB} 엔진 제조사, FIA PU 구성요소 문서 ${n0(E.docs)}건(이 사이트 추출)`} asof={engineAsof} />
        </Section>
      )
    }

    {
      RS && (
        <Section id="regulations" title={`규정 ${RS.year}`} meta={`<a href="${routes.regulations()}">규정 아카이브</a>`}>
          <div class="tbl-wrap" role="region" tabindex="0" aria-label={`${RS.year} 규정 마지막 판`}>
            <table class="dt">
              <caption class="sr-only">{RS.year} 규정 마지막 판과 앞 해와 비교한 바뀐 조항</caption>
              <thead>
                <tr><th scope="col">규정</th><th scope="col">마지막 판</th><th scope="col" class="num">바뀐 조항</th></tr>
              </thead>
              <tbody>
                {RS.latest.map((l) => (
                  <tr>
                    <td><a href={`${yearHref(RS.year)}#cmp-${l.section}`}>{SECTION_KO[l.section]}</a></td>
                    <td>
                      {l.doc ? (
                        <Fragment>
                          {issueName(l.doc.issue, l.doc.published_at?.slice(0, 10) ?? l.doc.version)}{' '}
                          {l.doc.status === 'needs_review' && <Fragment set:html={badgeHtml('review', '검수 대기')} />}
                          <Fragment set:html={extHtml(l.doc.url, 'PDF')} />
                        </Fragment>
                      ) : (
                        '문서 확인 안 됨'
                      )}
                    </td>
                    <td class="num">{l.cmp ? n0(changed(l.cmp)) : '미상'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <SourceLine source="fia.com 규정 아카이브 텍스트 PDF, 이 사이트 추출(조항 번호, 제목, 변경 유형)" asof={RS.asOf ? `${nw(RS.asOf)} 확인` : '확인일 기록 부재'} />
        </Section>
      )
    }
  </div>
</BaseLayout>
