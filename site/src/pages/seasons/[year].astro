---
// 시즌 쪽 /seasons/<year>/ (1950-2025). DESIGN.md "시즌" 와이어프레임과 연도별 규칙 표,
// design/final/season.html(2025), season-2004.html(2004)을 따른다. 문장과 표는 빌드 때 시즌 JSON에서 만든다.
import CalendarTable from '../../components/season/CalendarTable.astro';
import PaceSection from '../../components/season/PaceSection.astro';
import SeasonNav from '../../components/season/SeasonNav.astro';
import StandingsSection from '../../components/season/StandingsSection.astro';
import { calendarRead, factsList, leadHtml } from '../../components/season/season-text.ts';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeason, meta, seasonYears } from '../../lib/data.ts';
import { routes } from '../../lib/paths.ts';

export function getStaticPaths() {
  return seasonYears.map((y) => ({ params: { year: String(y) } }));
}

const year = Number(Astro.params.year);
const season = getSeason(year);
const kicker = [
  `<a href="${routes.seasons()}">시즌</a>`,
  `<span class="nw">${meta.first_season}-${meta.last_season}</span>`,
  String(year),
];
---

<BaseLayout
  title={`${year} 시즌`}
  description={`${year} 시즌 캘린더와 우승자, 드라이버와 컨스트럭터 순위 추이, 팀별 페이스 지수`}
  current="seasons"
>
  <PageHead kicker={kicker} title={`${year} 시즌`} lead={leadHtml(season)} facts={factsList(season)}>
    <SeasonNav year={year} />
  </PageHead>

  <Section id="calendar" title="캘린더와 우승자" read={calendarRead(season)} meta={`${season.facts.races}개 대회`}>
    <CalendarTable season={season} />
  </Section>

  <StandingsSection season={season} />

  <PaceSection season={season} />

  <script>
    import { ready } from '../../lib/charts/mount.ts';

    // 팀 페이스 지수 고르기: 퀄리파잉과 레이스는 서로 다른 차트다. 스크립트가 없으면 두 묶음이 모두 보인다.
    // 숨겨 둔 묶음은 보이게 될 때 mount()의 ResizeObserver가 그 너비로 그린다.
    const pmq = document.getElementById('pm-q');
    const pmr = document.getElementById('pm-r');
    const kinds = document.querySelectorAll<HTMLButtonElement>('#pm-kind [data-kind]');
    if (pmq && pmr && kinds.length) {
      pmr.hidden = true;
      kinds.forEach((btn) =>
        btn.addEventListener('click', () => {
          const k = btn.dataset.kind;
          kinds.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          pmq.hidden = k !== 'quali';
          pmr.hidden = k !== 'race';
        }),
      );
    }

    // 드라이버 강조 칩: 최대 3명. 넷째를 고르면 가장 먼저 고른 사람이 빠진다. 범례 글자도 함께 바꾼다.
    const chips = [...document.querySelectorAll<HTMLButtonElement>('#hl-drivers [data-id]')];
    let hl = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.id as string);
    const nameOf = (id: string) => chips.find((c) => c.dataset.id === id)?.textContent?.trim() ?? id;
    const paint = () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(hl.includes(c.dataset.id as string))));
      for (let k = 0; k < 3; k++) {
        const lab = document.getElementById(`lg-d${k}`);
        if (!lab) continue;
        const id = hl[k];
        lab.textContent = id ? nameOf(id) : '강조 0명';
        const li = lab.closest('li');
        if (li) li.hidden = !id;
      }
    };
    ready.then((handles) => {
      const drivers = handles.get('f-drivers');
      if (!drivers) return;
      chips.forEach((c) =>
        c.addEventListener('click', () => {
          const id = c.dataset.id as string;
          hl = hl.includes(id) ? hl.filter((x) => x !== id) : [...hl, id].slice(-3);
          drivers.redraw(null, { highlight: hl });
          paint();
        }),
      );
      paint();
    });
  </script>
</BaseLayout>
