    <DataTable caption={`${short} 계보 PU 공급사 구간`} columns={puCols} rows={M.puSpans} rowClass={(s) => (hasSwitch && s.to < curFrom ? 'lin-only' : '')} />
    <SourceLine source={`${F1DB} 시즌 엔트런트의 엔진 제조사, 계보 연결은 이 사이트의 계보 테이블`} asof={asofF1db()} />
  </Section>

